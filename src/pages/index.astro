---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FilmRollIntro from '../components/FilmRollIntro.astro';
import ScrollNav from '../components/ScrollNav.astro';
// The new type-first aperture hero (HERO_BUILD.md). The previous one is still at
// ../components/Hero.astro, unused, until the owner says to delete it.
import Hero from '../components/hero/Hero.astro';
import Sprockets from '../components/Sprockets.astro';
import Gap from '../components/Gap.astro';
import Offer from '../components/Offer.astro';
import Portfolio from '../components/Portfolio.astro';
import Clients from '../components/Clients.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Seo from '../components/Seo.astro';
import SeasonalOffer from '../components/SeasonalOffer.astro';
import WhoWeHelp from '../components/WhoWeHelp.astro';
import WhyRealPhotos from '../components/WhyRealPhotos.astro';
import FAQ from '../components/FAQ.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <a href="#hero" class="skip-link">Skip intro</a>
  <Header transition:persist />
  <main id="main-content">
  <FilmRollIntro />
  <ScrollNav />
  <!-- To switch to footage later, change only these props, e.g.
         <Hero mode="video" poster={posterImg} videoDesktop={{ webm, mp4 }} videoMobile={{ webm, mp4 }} priority={false} />
         <Hero mode="stills" stills={[a, b, c]} priority={false} />
       priority={false} because the film-roll intro sits above the hero and owns this
       page's LCP; the hero's own image must not compete with it. -->
  <Hero mode="type" />
  <Sprockets />
  <SeasonalOffer />
  <WhoWeHelp />
  <Sprockets dark />
  <WhyRealPhotos />
  <Sprockets />
  <Gap />
  <Sprockets dark />
  <Offer />
  <Sprockets />
  <Portfolio />
  <Sprockets dark />
  <Clients />
  <Sprockets />
  <Process />
  <Sprockets />
  <About />
  <Sprockets dark />
  <Seo />
  <Sprockets />
  <FAQ />
  <NewsletterSignup />
  </main>
  <Footer />
</Layout>

<!-- Animation bootstrap (initFilmRollIntro, initHeroTimeline, etc.) now
     lives in Layout.astro's single shared script, not here - see that
     file's script comment for why a per-page script can't reliably do
     this once Astro's client-side page transitions are in play. -->
