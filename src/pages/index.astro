---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FilmRollIntro from '../components/FilmRollIntro.astro';
import ScrollNav from '../components/ScrollNav.astro';
import Hero from '../components/Hero.astro';
import Sprockets from '../components/Sprockets.astro';
import Gap from '../components/Gap.astro';
import Offer from '../components/Offer.astro';
import Portfolio from '../components/Portfolio.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Seo from '../components/Seo.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <a href="#hero" class="skip-link">Skip intro</a>
  <Header transition:persist />
  <FilmRollIntro />
  <ScrollNav />
  <Hero />
  <Sprockets />
  <Gap />
  <Sprockets dark />
  <Offer />
  <Sprockets />
  <Portfolio />
  <Sprockets dark />
  <Process />
  <Sprockets />
  <About />
  <Sprockets dark />
  <Seo />
  <NewsletterSignup />
  <Footer />
</Layout>

<!-- Animation bootstrap (initFilmRollIntro, initHeroTimeline, etc.) now
     lives in Layout.astro's single shared script, not here - see that
     file's script comment for why a per-page script can't reliably do
     this once Astro's client-side page transitions are in play. -->
