---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FilmRollIntro from '../components/FilmRollIntro.astro';
import ScrollNav from '../components/ScrollNav.astro';
import Hero from '../components/Hero.astro';
import Sprockets from '../components/Sprockets.astro';
import Gap from '../components/Gap.astro';
import Offer from '../components/Offer.astro';
import Portfolio from '../components/Portfolio.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Seo from '../components/Seo.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <a href="#hero" class="skip-link">Skip intro</a>
  <Header />
  <FilmRollIntro />
  <ScrollNav />
  <Hero />
  <Sprockets />
  <Gap />
  <Sprockets dark />
  <Offer />
  <Sprockets />
  <Portfolio />
  <Sprockets dark />
  <Process />
  <Sprockets />
  <About />
  <Sprockets dark />
  <Seo />
  <Contact />
  <Footer />
</Layout>

<script>
  import {
    initScrollHashFix,
    initFilmRollIntro,
    initScrollReveals,
    initPersistBgFade,
    initHeroTimeline,
    initHeroParallax,
    initContactSheetReveal,
    initNavOnScroll,
    initMagneticButtons,
    initPortfolioLightbox,
    initVideoLightbox,
    initScrollNav,
    initHeadingSplitReveal,
    initSectionTransitions,
  } from '../scripts/animations';
  import { initSmoothScroll } from '../scripts/lenis';

  initSmoothScroll();
  initScrollHashFix();
  initFilmRollIntro();
  initPersistBgFade();
  initHeroTimeline();
  initHeroParallax();
  initScrollReveals();
  initContactSheetReveal();
  initNavOnScroll();
  initMagneticButtons();
  initPortfolioLightbox();
  initVideoLightbox();
  initScrollNav();
  initHeadingSplitReveal();
  initSectionTransitions();
</script>
