---
// FILM-STRIP-RIBBON-BRIEF.md - throwaway spike page, not linked from
// anywhere in the site nav, noindex, deleted in Phase E's cleanup.
// Phase A: curve + twist + gate shape, no photos.
// Phase B: real photos via a runtime texture atlas, correct 35mm
// proportions, back-side rendering, edge print baked into the atlas.
// Phase C (this pass): scroll-driven feed and idle drift, both writing to
// the SAME uOffset value via relative deltas (not two absolute-state
// writers) - see the "single source of truth" comment in main() below;
// that pattern is a direct application of the fix for the DOM intro's
// idleVisibility/pin race condition (CLAUDE.md, animations.ts).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Same 9-photo pool and hero pick as FilmRollIntro.astro (section 9 Q1
// was answered as "reuse the DOM intro's own curated pool" rather than
// picking a separate set for the WebGL version) - keeps continuity for
// Phase D's eventual handoff, where the ribbon's hero cell needs to be
// the same photo the DOM intro locks on.
const rollPhotoEntries = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/photos/portfolio/{Barbershops,consumables,product advertisement,IMG_0839,IMG_0863,IMG_1643,IMG_3033,IMG_8758,motorcycle-rider}.jpg',
    { eager: true }
  )
);
const heroPath = rollPhotoEntries.find(([path]) => path.includes('motorcycle-rider'))?.[0];

// 512px source is plenty for a ~340px-tall atlas cell (Phase B builds the
// atlas at runtime in the browser, not at build time, since it's drawn
// into a canvas alongside baked edge-print text - see buildAtlas() below).
const atlasPhotos = await Promise.all(
  rollPhotoEntries.map(async ([path, mod], i) => {
    const img = await getImage({ src: mod.default, width: 512, format: 'webp' });
    return { src: img.src, isHero: path === heroPath, index: i };
  })
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab: Film Strip Ribbon (Phase C)</title>
    <style>
      html, body { margin: 0; background: #0A0E13; }
      /* Phase C: real document scroll drives the feed, so the page needs
         scroll distance - the canvas stays fixed full-viewport over it.
         (The canvas's fixed positioning is set in JS, not here - Astro's
         scoped styles can't reach an element the script creates.) */
      #scroll-spacer { height: 400vh; }
      #panel {
        position: fixed; top: 12px; left: 12px; z-index: 10;
        background: rgba(18, 24, 31, 0.85);
        border: 1px solid rgba(234, 242, 248, 0.16);
        border-radius: 8px;
        padding: 14px 16px;
        font-family: 'IBM Plex Mono', 'Courier New', monospace;
        font-size: 11px;
        color: #EAF2F8;
        width: 260px;
        backdrop-filter: blur(8px);
      }
      #panel h1 {
        font-size: 12px; margin: 0 0 10px; color: #E6C468;
        text-transform: uppercase; letter-spacing: 0.06em;
      }
      #panel label {
        display: flex; justify-content: space-between; align-items: center;
        gap: 8px; margin-bottom: 8px;
      }
      #panel label span:first-child { color: #9FB1C2; flex-shrink: 0; }
      #panel output { color: #E6C468; width: 44px; text-align: right; flex-shrink: 0; }
      #panel input[type="range"] { flex: 1; accent-color: #E6C468; }
      #panel .hint { color: #9FB1C2; opacity: 0.7; margin-top: 10px; line-height: 1.5; }
      #stats {
        position: fixed; bottom: 12px; left: 12px; z-index: 10;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #9FB1C2;
      }
    </style>
  </head>
  <body>
    <div id="panel">
      <h1>Ribbon Tuning &mdash; Phase A</h1>
      <label><span>Twist peak</span><input type="range" id="twistMaxDeg" min="0" max="220" value="143" step="1" /><output>143&deg;</output></label>
      <label><span>Curl start (t)</span><input type="range" id="curlStart" min="0" max="0.5" value="0.28" step="0.01" /><output>0.28</output></label>
      <label><span>Curl end (t)</span><input type="range" id="curlEnd" min="0.15" max="0.7" value="0.59" step="0.01" /><output>0.59</output></label>
      <label><span>Gate start (t)</span><input type="range" id="gateStart" min="0.4" max="0.85" value="0.80" step="0.01" /><output>0.80</output></label>
      <label><span>Gate end (t)</span><input type="range" id="gateEnd" min="0.5" max="0.98" value="0.95" step="0.01" /><output>0.95</output></label>
      <label><span>Strip width</span><input type="range" id="stripWidth" min="1.5" max="6" value="4.1" step="0.1" /><output>4.1</output></label>
      <label><span>Depth (curl Z)</span><input type="range" id="curlDepth" min="0" max="6" value="0" step="0.1" /><output>0.0</output></label>
      <label><span>Show gate plane</span><input type="checkbox" id="showGate" checked /><output></output></label>
      <label><span>Show control pts</span><input type="checkbox" id="showControls" checked /><output></output></label>
      <div class="hint">Drag to orbit, scroll to zoom (OrbitControls). This page is a dev-only spike &mdash; not linked, noindex, deleted before ship.</div>
    </div>
    <div id="stats"></div>
    <div id="scroll-spacer" aria-hidden="true"></div>

    <script type="application/json" id="atlas-photo-data" set:html={JSON.stringify(atlasPhotos)} />

    <script>
      import * as THREE from 'three';
      import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // ---- Real 35mm proportions (FILM-STRIP-RIBBON-BRIEF.md section 2) ----
      const FILM_WIDTH_MM = 35;
      const FRAME_WIDTH_MM = 36; // along the strip (u)
      const FRAME_HEIGHT_MM = 24; // image area height
      const PERF_PITCH_MM = 4.75;
      const PERFS_PER_FRAME = 8;
      const FRAME_PITCH_MM = PERF_PITCH_MM * PERFS_PER_FRAME; // 38mm - matches 36mm image + ~2mm gap
      const MM_TO_UNIT = 1 / 10; // 1 scene unit = 10mm = 1cm, keeps numbers readable

      // Shared between the procedural perforation/gap shader math AND the
      // atlas bake below, so the image area and edge-print bands line up
      // with the real holes rather than drifting if one gets tuned later.
      const PERF_PITCH_U = PERF_PITCH_MM / FRAME_PITCH_MM;
      // See the note by uPerfHalfW below (real KS perforation proportions).
      const PERF_HALF_W_U = PERF_PITCH_U * 0.21;
      const PERF_HALF_H_V = 0.045;
      const PERF_MARGIN_V = 0.07;
      const GAP_HALF_U = 0.012;
      // Image area inset from each frame's u edges - real 135 film has ~1mm
      // of clear film either side of the 36mm image within the 38mm pitch
      // (~0.026 of the pitch); a bit more here reads as a cleaner border.
      const IMAGE_MARGIN_U = 0.035;
      const IMAGE_U_MIN = GAP_HALF_U + IMAGE_MARGIN_U;
      const IMAGE_U_MAX = 1 - GAP_HALF_U - IMAGE_MARGIN_U;
      // Image area sits centred between the two perforation rows, leaving a
      // thin band above/below each row for the edge print / frame number.
      const IMAGE_V_MIN = PERF_MARGIN_V + PERF_HALF_H_V + 0.045;
      const IMAGE_V_MAX = 1 - IMAGE_V_MIN;
      // Vertical centre (in cell-local v) of the two edge-print bands that
      // sit between each perforation row and the image area.
      const FRAME_NUM_BAND_V = (PERF_MARGIN_V + PERF_HALF_H_V + IMAGE_V_MIN) / 2;
      const SITE_NAME_BAND_V = (IMAGE_V_MAX + (1 - PERF_MARGIN_V - PERF_HALF_H_V)) / 2;

      // ---- Tunable params, wired to the dev panel. Values below are the
      // founder's own tuning pass over Phase A's shape (2026-09-23) -
      // flatter curl (curlDepth 0, a near-2D spiral rather than a
      // depth-separated coil), a tighter/later twist window, a wider strip. ----
      const params = {
        twistMaxDeg: 143,
        curlStart: 0.28,
        curlEnd: 0.59,
        gateStart: 0.8,
        gateEnd: 0.95, // gate marker span only (start..end) - see note above the params object
        stripWidth: 4.1, // scene units (overrides the raw mm conversion for Phase A's shape tuning)
        curlDepth: 0,
        showGate: true,
        showControls: true,
      };

      // ---- Phase C: scroll-driven feed + idle drift ----
      // One value, one writer per frame - both the ScrollTrigger callback
      // and the idle-drift tick in animate() only ever ADD a relative delta
      // to `feed.offset`, never overwrite it absolutely. That's what makes
      // the handoff jump-free: whichever source was moving it last, the
      // other picks up from exactly where it left off. See the animations.ts
      // idleVisibility fix this mirrors (CLAUDE.md) - that bug was two
      // controllers each asserting an ABSOLUTE play/pause state for the same
      // tween; the fix here is the same lesson applied to a continuous value.
      const DRIFT_SPEED_PER_SEC = 0.045; // frame-units/sec of idle feed
      const SCROLL_RANGE_FRAMES = 14; // how far the full scroll-spacer feeds
      const IDLE_RESUME_MS = 350; // pause drift briefly after scroll input, so it doesn't fight scrub's own trailing ease
      const feed = { offset: 0, lastInputTime: 0 };

      // ---- Scene ----
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0a0e13);

      const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 200);
      camera.position.set(-1, 3, 20);

      const renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);
      // Astro's scoped <style> canvas{} rule can't reach an element created
      // by JS (it only rewrites selectors for elements literally written in
      // this file's template), so the fixed full-viewport positioning has
      // to be set here instead - otherwise the canvas sits in normal
      // document flow, after the scroll-spacer div in the DOM, and renders
      // ~400vh below the visible viewport.
      renderer.domElement.style.position = 'fixed';
      renderer.domElement.style.inset = '0';
      document.body.appendChild(renderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.target.set(-2, 1, 0);

      // Simple directional-ish fill so the gate marker / control-point dots
      // read in 3D even though the ribbon itself uses fake shader lighting.
      scene.add(new THREE.AmbientLight(0xffffff, 0.6));
      const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
      dirLight.position.set(5, 8, 6);
      scene.add(dirLight);

      // ---- Curve: enters top-left, curls with depth, flattens through the
      // gate, exits bottom-right diagonally. Matches the reference's BEATS
      // (entry direction, one curl, diagonal exit through a flat gate), not
      // its literal control points - stock clip art, shape-reference only. ----
      function buildControlPoints(p: typeof params) {
        const d = p.curlDepth;
        return [
          new THREE.Vector3(-15, 7.5, -2), // off-screen top-left, entering
          new THREE.Vector3(-9, 6.3, 1.5), // heading right, coming toward camera
          new THREE.Vector3(-6.5, 4.8, -d), // curl: pushed BEHIND for depth crossing
          new THREE.Vector3(-7.5, 2.2, d * 0.9), // curl: swings back toward camera
          new THREE.Vector3(-4.5, 0.4, 0.4), // easing out of the curl
          new THREE.Vector3(-1, -0.8, 0), // approaching the gate, flattening
          new THREE.Vector3(2.5, -2, 0), // gate: flat, camera-facing
          new THREE.Vector3(7, -4.2, -0.3), // diagonal exit begins
          new THREE.Vector3(13, -7, -1.5), // off-screen bottom-right, exiting
        ];
      }

      // Twist (roll) as a function of normalized arc-length t - deliberately
      // NOT derived from the curve's own curvature. Zero at entry, ramps up
      // through the curl (curlStart -> curlEnd), forced back to exactly zero
      // across the whole gate span (gateStart -> gateEnd) and stays zero
      // after, matching the brief's "twist must be zero at the gate".
      function twistAngle(t: number, p: typeof params): number {
        const max = (p.twistMaxDeg * Math.PI) / 180;
        const { curlStart, curlEnd, gateStart } = p;
        if (t <= curlStart) return 0;
        if (t <= curlEnd) {
          const local = (t - curlStart) / (curlEnd - curlStart);
          // smoothstep up
          return max * (local * local * (3 - 2 * local));
        }
        if (t <= gateStart) {
          const local = (t - curlEnd) / (gateStart - curlEnd);
          const eased = local * local * (3 - 2 * local);
          return max * (1 - eased);
        }
        return 0; // flat through and after the gate
      }

      let curve: THREE.CatmullRomCurve3;
      let ribbonMesh: THREE.Mesh;
      let gateHelper: THREE.Group;
      let controlPointDots: THREE.Group;

      const SEGMENTS = 360;

      const vertexShader = `
        varying vec2 vUv;
        varying vec3 vNormalW;
        varying vec3 vViewDir;
        void main() {
          vUv = uv;
          vec4 worldPos = modelMatrix * vec4(position, 1.0);
          vNormalW = normalize(mat3(modelMatrix) * normal);
          vViewDir = normalize(cameraPosition - worldPos.xyz);
          gl_Position = projectionMatrix * viewMatrix * worldPos;
        }
      `;

      const fragmentShader = `
        precision highp float;
        varying vec2 vUv;
        varying vec3 vNormalW;
        varying vec3 vViewDir;

        uniform sampler2D uAtlas;
        uniform float uAtlasCols;
        uniform float uAtlasRows;
        uniform float uAtlasFrames;
        uniform vec3 uBaseBack;
        uniform vec3 uGapColor;
        uniform float uPerfPitchU;   // perforation pitch, in u (frame) units
        uniform float uPerfHalfW;    // perforation half-width, in u units
        uniform float uPerfHalfH;    // perforation half-height, in v units
        uniform float uPerfMarginV;  // v-distance of perf row centres from each edge
        uniform float uGapHalfU;     // half-width of the inter-frame gap band, in u units
        uniform float uOffset;       // scroll/drift feed position, in frame units

        float sdRoundRect(vec2 p, vec2 halfSize, float r) {
          vec2 d = abs(p) - halfSize + r;
          return length(max(d, 0.0)) - r + min(max(d.x, d.y), 0.0);
        }

        void main() {
          bool front = gl_FrontFacing;
          float u = vUv.x + uOffset;
          float uInFrame = fract(u);

          // Atlas cell for this frame: each cell already bakes the base
          // film colour, the photo in its image-area rect, and the edge
          // print text (see buildAtlas() in main()) - the shader just picks
          // the right cell and, on the back face, mirrors + darkens it
          // rather than sampling a second baked "back" atlas.
          float frameIndex = floor(u);
          float frameInAtlas = mod(frameIndex, uAtlasFrames);
          float col = mod(frameInAtlas, uAtlasCols);
          float row = floor(frameInAtlas / uAtlasCols);
          float sampleU = front ? uInFrame : (1.0 - uInFrame);
          // Small inset guards against bilinear bleed from the neighbouring cell.
          sampleU = clamp(sampleU, 0.004, 0.996);
          float sampleV = clamp(vUv.y, 0.004, 0.996);
          vec2 cellUv = vec2((col + sampleU) / uAtlasCols, (row + sampleV) / uAtlasRows);
          vec3 color = texture2D(uAtlas, cellUv).rgb;

          if (!front) {
            color = mix(color, uBaseBack, 0.55);
            color *= 0.8;
          }

          // Frame gap: a thin darker band at each frame boundary (u is in frame units).
          float gap = step(uInFrame, uGapHalfU) + step(1.0 - uGapHalfU, uInFrame);
          color = mix(color, uGapColor, clamp(gap, 0.0, 1.0));

          // Perforations: repeat along u at uPerfPitchU, two rows near v=0 and v=1.
          float uCell = fract(u / uPerfPitchU) * uPerfPitchU - uPerfPitchU * 0.5;
          float dTop = sdRoundRect(vec2(uCell, vUv.y - uPerfMarginV), vec2(uPerfHalfW, uPerfHalfH), uPerfHalfH * 0.4);
          float dBot = sdRoundRect(vec2(uCell, vUv.y - (1.0 - uPerfMarginV)), vec2(uPerfHalfW, uPerfHalfH), uPerfHalfH * 0.4);
          if (dTop < 0.0 || dBot < 0.0) discard;

          // Fake lighting: darken as the surface turns edge-on to the camera,
          // so the curl and twist read as real 3D rather than a flat texture.
          float ndotv = clamp(dot(normalize(vNormalW), normalize(vViewDir)), 0.0, 1.0);
          float shade = mix(0.55, 1.0, pow(ndotv, 0.85));
          color *= shade;

          gl_FragColor = vec4(color, 1.0);
        }
      `;

      // Orange-brown colour-negative base (section 9 Q3) - ties into the
      // existing DOM develop effect's warm cast once Phase D hands off.
      // uAtlas/uAtlasCols/uAtlasRows/uAtlasFrames are filled in once the
      // runtime atlas finishes building - see buildAtlas() and main() below.
      const material = new THREE.ShaderMaterial({
        side: THREE.DoubleSide,
        uniforms: {
          uBaseBack: { value: new THREE.Color(0x4a2c1a) },
          uGapColor: { value: new THREE.Color(0x120a06) },
          uPerfPitchU: { value: PERF_PITCH_U },
          // Real KS perforations are ~1.98mm wide within a 4.75mm pitch
          // (~42% of the pitch, so half-width ~0.21x pitch) and ~2.79mm
          // tall within the 35mm strip width (~8%, half-height ~0.04).
          // The original 0.32/0.09 values were oversized enough that
          // perforations covered a majority of each cell instead of a
          // minority - confirmed by disabling the discard entirely and
          // comparing the raw (solid) ribbon against the perforated one.
          uPerfHalfW: { value: PERF_HALF_W_U },
          uPerfHalfH: { value: PERF_HALF_H_V },
          uPerfMarginV: { value: PERF_MARGIN_V },
          uGapHalfU: { value: GAP_HALF_U },
          uAtlas: { value: null as THREE.CanvasTexture | null },
          uAtlasCols: { value: 1 },
          uAtlasRows: { value: 1 },
          uAtlasFrames: { value: 1 },
          // The strip shape stays still; scrolling/drift only change this
          // (brief section 2) - added to vUv.x once, up front, so frame
          // lookup, perforations and the gap band all advance together
          // exactly like a real strip feeding through a projector.
          uOffset: { value: 0 },
        },
        vertexShader,
        fragmentShader,
      });

      function buildRibbonGeometry(curveIn: THREE.CatmullRomCurve3, p: typeof params) {
        const points = curveIn.getSpacedPoints(SEGMENTS);
        const frenet = curveIn.computeFrenetFrames(SEGMENTS, false);
        const { tangents, binormals } = frenet;

        let totalLength = 0;
        const lengths: number[] = [0];
        for (let i = 1; i <= SEGMENTS; i++) {
          totalLength += points[i].distanceTo(points[i - 1]);
          lengths.push(totalLength);
        }

        const positions: number[] = [];
        const normalsOut: number[] = [];
        const uvs: number[] = [];
        const indices: number[] = [];
        const halfWidth = (p.stripWidth * MM_TO_UNIT * 10) / 2; // stripWidth already in scene units

        for (let i = 0; i <= SEGMENTS; i++) {
          const t = i / SEGMENTS;
          const twist = twistAngle(t, p);

          const tangent = tangents[i].clone().normalize();
          const binormal = binormals[i].clone().applyAxisAngle(tangent, twist).normalize();
          const normal = new THREE.Vector3().crossVectors(binormal, tangent).normalize();

          const center = points[i];
          const p1 = center.clone().addScaledVector(binormal, halfWidth);
          const p2 = center.clone().addScaledVector(binormal, -halfWidth);

          positions.push(p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
          normalsOut.push(normal.x, normal.y, normal.z, normal.x, normal.y, normal.z);

          const uFrameUnits = lengths[i] / (FRAME_PITCH_MM * MM_TO_UNIT * 10 * (p.stripWidth / 3.2));
          uvs.push(uFrameUnits, 0, uFrameUnits, 1);

          if (i < SEGMENTS) {
            const a = i * 2, b = i * 2 + 1, c = (i + 1) * 2, d = (i + 1) * 2 + 1;
            indices.push(a, c, b, b, c, d);
          }
        }

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        geometry.setAttribute('normal', new THREE.Float32BufferAttribute(normalsOut, 3));
        geometry.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
        geometry.setIndex(indices);
        return geometry;
      }

      function buildGateHelper(curveIn: THREE.CatmullRomCurve3, p: typeof params): THREE.Group {
        const group = new THREE.Group();
        const tGate = (p.gateStart + p.gateEnd) / 2;
        const point = curveIn.getPointAt(tGate);
        const geo = new THREE.PlaneGeometry(p.stripWidth * 1.4, p.stripWidth * 1.4 * (FRAME_HEIGHT_MM / FRAME_WIDTH_MM));
        const mat = new THREE.MeshBasicMaterial({ color: 0xe6c468, wireframe: true, transparent: true, opacity: 0.5 });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.copy(point);
        group.add(mesh);
        return group;
      }

      function buildControlPointDots(points: THREE.Vector3[]): THREE.Group {
        const group = new THREE.Group();
        const geo = new THREE.SphereGeometry(0.18, 12, 12);
        points.forEach((pt, i) => {
          const mat = new THREE.MeshBasicMaterial({ color: i === 0 ? 0x4fa8de : 0xe8975a });
          const dot = new THREE.Mesh(geo, mat);
          dot.position.copy(pt);
          group.add(dot);
        });
        return group;
      }

      // ---- Phase B: texture atlas ----
      // Loads the real portfolio photos and bakes each into its own atlas
      // cell alongside the base film colour and edge-print text, so the
      // fragment shader can do one texture2D() lookup per pixel instead of
      // rendering text or compositing layers at runtime. Each cell covers
      // one FULL frame (u: 0..1 across the frame pitch, v: 0..1 across the
      // strip width) - the shader still does perforations/gaps procedurally
      // via SDF on top, since those need to stay pixel-sharp at any zoom.
      type AtlasPhoto = { src: string; isHero: boolean; index: number };

      function loadImage(src: string): Promise<HTMLImageElement> {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => resolve(img);
          img.onerror = reject;
          img.src = src;
        });
      }

      async function buildAtlas(photos: AtlasPhoto[]) {
        const cols = Math.ceil(Math.sqrt(photos.length));
        const rows = Math.ceil(photos.length / cols);
        const cellW = 512;
        const cellH = Math.round(cellW * (FILM_WIDTH_MM / FRAME_PITCH_MM)); // full-frame aspect (35/38)

        const canvas = document.createElement('canvas');
        canvas.width = cellW * cols;
        canvas.height = cellH * rows;
        const ctx = canvas.getContext('2d')!;

        const images = await Promise.all(photos.map((p) => loadImage(p.src)));

        photos.forEach((photo, i) => {
          const cx = (i % cols) * cellW;
          const cy = Math.floor(i / cols) * cellH;

          // Base film colour fill - same orange-brown as the old flat base.
          ctx.fillStyle = '#8a4d24';
          ctx.fillRect(cx, cy, cellW, cellH);

          // Image area rect, in this cell's own pixels.
          const ix = cx + IMAGE_U_MIN * cellW;
          const iy = cy + IMAGE_V_MIN * cellH;
          const iw = (IMAGE_U_MAX - IMAGE_U_MIN) * cellW;
          const ih = (IMAGE_V_MAX - IMAGE_V_MIN) * cellH;

          // Cover-fit the photo into the image area (photo is ~36:24 = 3:2
          // already from the Astro pipeline crop, so this is close to a
          // straight draw, but cover-fit guards against any source that isn't).
          const img = images[i];
          const srcAspect = img.width / img.height;
          const dstAspect = iw / ih;
          let sx = 0, sy = 0, sw = img.width, sh = img.height;
          if (srcAspect > dstAspect) {
            sw = img.height * dstAspect;
            sx = (img.width - sw) / 2;
          } else {
            sh = img.width / dstAspect;
            sy = (img.height - sh) / 2;
          }
          ctx.drawImage(img, sx, sy, sw, sh, ix, iy, iw, ih);

          // Edge print, baked - no real film-brand trademarks (brief section 7).
          ctx.fillStyle = 'rgba(234, 242, 248, 0.55)';
          ctx.textBaseline = 'middle';

          // Band below the image area, above the bottom perf row: site name.
          ctx.font = `${Math.round(cellH * 0.038)}px 'Courier New', monospace`;
          ctx.textAlign = 'left';
          ctx.fillText('HORIZON VANTAGE 400', ix, cy + SITE_NAME_BAND_V * cellH);

          // Band above the image area, below the top perf row: frame number.
          ctx.textAlign = 'right';
          const frameNum = String(photo.index + 1).padStart(3, '0');
          ctx.fillText(`FRAME ${frameNum}`, ix + iw, cy + FRAME_NUM_BAND_V * cellH);
        });

        const texture = new THREE.CanvasTexture(canvas);
        texture.wrapS = THREE.ClampToEdgeWrapping;
        texture.wrapT = THREE.ClampToEdgeWrapping;
        texture.colorSpace = THREE.SRGBColorSpace;
        texture.needsUpdate = true;

        return { texture, cols, rows, frames: photos.length };
      }

      function rebuild() {
        const controlPoints = buildControlPoints(params);
        curve = new THREE.CatmullRomCurve3(controlPoints, false, 'catmullrom', 0.5);

        if (ribbonMesh) {
          scene.remove(ribbonMesh);
          ribbonMesh.geometry.dispose();
        }
        const geometry = buildRibbonGeometry(curve, params);
        ribbonMesh = new THREE.Mesh(geometry, material);
        scene.add(ribbonMesh);

        if (gateHelper) scene.remove(gateHelper);
        gateHelper = buildGateHelper(curve, params);
        gateHelper.visible = params.showGate;
        scene.add(gateHelper);

        if (controlPointDots) scene.remove(controlPointDots);
        controlPointDots = buildControlPointDots(controlPoints);
        controlPointDots.visible = params.showControls;
        scene.add(controlPointDots);
      }

      // ---- Dev panel wiring ----
      function bindRange(id: string, key: keyof typeof params, fmt: (v: number) => string = (v) => v.toFixed(2)) {
        const input = document.getElementById(id) as HTMLInputElement;
        const output = input.nextElementSibling as HTMLOutputElement;
        output.textContent = fmt(Number(input.value));
        input.addEventListener('input', () => {
          (params as any)[key] = Number(input.value);
          output.textContent = fmt(Number(input.value));
          rebuild();
        });
      }
      bindRange('twistMaxDeg', 'twistMaxDeg', (v) => `${v.toFixed(0)}°`);
      bindRange('curlStart', 'curlStart');
      bindRange('curlEnd', 'curlEnd');
      bindRange('gateStart', 'gateStart');
      bindRange('gateEnd', 'gateEnd');
      bindRange('stripWidth', 'stripWidth', (v) => v.toFixed(1));
      bindRange('curlDepth', 'curlDepth', (v) => v.toFixed(1));

      document.getElementById('showGate')!.addEventListener('change', (e) => {
        params.showGate = (e.target as HTMLInputElement).checked;
        gateHelper.visible = params.showGate;
      });
      document.getElementById('showControls')!.addEventListener('change', (e) => {
        params.showControls = (e.target as HTMLInputElement).checked;
        controlPointDots.visible = params.showControls;
      });

      // ---- Resize + render loop ----
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      const statsEl = document.getElementById('stats')!;
      let frameCount = 0;
      let lastFpsTime = performance.now();
      let lastFrameTime = performance.now();
      function animate() {
        requestAnimationFrame(animate);

        const now = performance.now();
        const dt = Math.min((now - lastFrameTime) / 1000, 0.1); // clamp guards against tab-away catch-up jumps
        lastFrameTime = now;

        const idle = now - feed.lastInputTime > IDLE_RESUME_MS;
        if (idle) feed.offset += DRIFT_SPEED_PER_SEC * dt;
        material.uniforms.uOffset.value = feed.offset;

        controls.update();
        renderer.render(scene, camera);

        frameCount++;
        if (now - lastFpsTime > 500) {
          const fps = Math.round((frameCount * 1000) / (now - lastFpsTime));
          const mode = idle ? 'drift' : 'scroll';
          statsEl.textContent = `${fps} fps · ${SEGMENTS} segments · ${ribbonMesh.geometry.attributes.position.count} verts · offset ${feed.offset.toFixed(2)} (${mode})`;
          frameCount = 0;
          lastFpsTime = now;
        }
      }
      // ---- Init: build the atlas first, then start rendering ----
      async function main() {
        const dataEl = document.getElementById('atlas-photo-data')!;
        const photos: AtlasPhoto[] = JSON.parse(dataEl.textContent || '[]');
        const atlas = await buildAtlas(photos);
        material.uniforms.uAtlas.value = atlas.texture;
        material.uniforms.uAtlasCols.value = atlas.cols;
        material.uniforms.uAtlasRows.value = atlas.rows;
        material.uniforms.uAtlasFrames.value = atlas.frames;

        rebuild();

        // Scroll drives feed via a relative delta each update (see the
        // `feed` comment above) - never `feed.offset = self.progress * N`,
        // which would snap on every resize/refresh and on the very first
        // update after idle drift had already moved the offset elsewhere.
        let lastProgress = 0;
        ScrollTrigger.create({
          trigger: '#scroll-spacer',
          start: 'top top',
          end: 'bottom bottom',
          scrub: true, // not a numeric lag value - see CLAUDE.md's Lenis/GSAP double-smoothing note
          onUpdate: (self) => {
            feed.offset += (self.progress - lastProgress) * SCROLL_RANGE_FRAMES;
            lastProgress = self.progress;
            feed.lastInputTime = performance.now();
          },
        });

        animate();
      }
      main();
    </script>
  </body>
</html>
