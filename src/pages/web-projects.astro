---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Sprockets from '../components/Sprockets.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Real project entries go here once work is ready to show - same
// scaffold-then-fill pattern as Portfolio.astro's `videos` array. Each
// entry needs a screenshot dropped in src/assets/photos/web-projects/
// alongside a title, short description, and (optional) live link.
type Project = {
  title: string;
  description: string;
  href?: string;
  screenshot?: ImageMetadata;
};
const projects: Project[] = [];
const hasProjects = projects.length > 0;

// Same hand-drawn minimal line-icon approach as local-seo.astro (24x24,
// stroke-based, currentColor) - kept local to each page rather than shared,
// since the two pages' icon sets barely overlap and a shared file would
// mostly just be dead weight per page. Reused deliberately within this
// page (camera/code appear in both the process and the reasons) so the
// same icon carries the same meaning wherever it shows up.
const ICONS: Record<string, string> = {
  camera: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.6-2.4h6.8L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13.5" r="3.4"/></svg>',
  layout: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M3 9.5h18"/><path d="M9 9.5V20"/></svg>',
  code: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/><path d="m13.5 6-3 12"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m8.2 12.3 2.5 2.5 5-5.2"/></svg>',
  bolt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg>',
  key: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="14" r="3.6"/><path d="M10.5 11.5 20 2m-3 3 2 2m-5 1 2 2"/></svg>',
};

const steps = [
  { icon: 'camera', title: 'Shoot', desc: 'The same on-site visit that covers your photography and video also gives the raw material for the site — real shots of your actual space, not a stock template.' },
  { icon: 'layout', title: 'Design around the photos', desc: 'Layout, colour and structure are chosen to fit the images that were actually shot, not a generic template with photos squeezed in afterward.' },
  { icon: 'code', title: 'Build', desc: 'Hand-built with a modern, fast-loading stack — not assembled from a page-builder subscription. The same standard of engineering behind this site is behind yours.' },
  { icon: 'check', title: 'Launch & review', desc: "Live and reviewed with you before anything goes public, alongside the Google Business Profile setup, so the site and the listing launch together." },
];

const reasons = [
  { icon: 'camera', title: 'Real photos, not stock', desc: 'A visitor can spot a stock photo in about a second. Real photos of your actual business are the fastest way to look active and trustworthy instead of a placeholder page.' },
  { icon: 'bolt', title: 'Built fast, loads fast', desc: 'A modern, hand-built stack instead of a bloated page-builder - quick to load on a phone with patchy signal, which matters for the map-pack click-through the local SEO work is chasing.' },
  { icon: 'code', title: 'One person, shoot to launch', desc: 'No handoff between a separate photographer, designer and developer. The same person shoots the photos and builds the site around them.' },
  { icon: 'key', title: 'A site you actually own', desc: "A real, custom-built codebase - not a locked page-builder subscription you're renting month to month." },
];
---

<Layout
  title="Web Design Work — Horizon Vantage"
  description="Website builds for local businesses in Wicklow, designed around real on-site photography instead of a template."
>
  <Header transition:persist />

  <PageHero
    frameNum="014"
    frameLabel="Web Projects"
    title="Websites built around real photography, not a template."
    subtitle="Every build starts from the same on-site shoot as the photography and video work — the site is designed around the images, not the other way around."
    variant="grid"
  />

  <section id="web-projects-process">
    <div class="wrap">
      <div class="section-head" data-reveal data-reveal-group="wp-process-head">
        <div class="frame-tag"><span class="num">FRAME 015</span> How It's Built</div>
        <h2 class="section-h" data-split-reveal>Four steps, one person, start to finish.</h2>
      </div>
      <div class="wp-steps">
        {steps.map((s) => (
          <div class="wp-step" data-reveal data-reveal-group="wp-steps">
            <span class="wp-step-icon" set:html={ICONS[s.icon]} />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Sprockets />

  <section id="web-projects-why">
    <div class="wrap">
      <div class="wp-why-grid">
        <!-- Wireframe illustration, not a screenshot of a real build - no
             finished case study exists yet (see the section below), and
             dressing this up as one would misrepresent it. Tilts gently
             toward the cursor (initWebMockTilt, animations.ts) as the
             page's one bespoke "fluid" touch, matching the founder's
             request for more motion on this page specifically. -->
        <div class="wp-mock-wrap">
          <div class="wp-mock" data-mock-tilt data-reveal data-reveal-group="wp-why">
            <div class="wp-mock-chrome">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span class="wp-mock-url mono">yourbusiness.ie</span>
            </div>
            <div class="wp-mock-body">
              <div class="wp-mock-nav">
                <span class="wp-mock-logo"></span>
                <span></span><span></span><span></span>
              </div>
              <div class="wp-mock-hero">
                <span class="wp-mock-hero-icon" set:html={ICONS.camera} />
              </div>
              <div class="wp-mock-lines">
                <span class="l1"></span><span class="l2"></span><span class="l3"></span>
                <span class="wp-mock-btn"></span>
              </div>
            </div>
          </div>
        </div>
        <div class="wp-why-copy">
          <div class="frame-tag" data-reveal data-reveal-group="wp-why"><span class="num">FRAME 016</span> Why You Need One</div>
          <h2 class="section-h" data-reveal data-reveal-group="wp-why" data-split-reveal>Your Google listing sends people somewhere. Make it worth the click.</h2>
          <div class="wp-reasons">
            {reasons.map((r) => (
              <div class="wp-reason" data-reveal data-reveal-group="wp-reasons">
                <span class="wp-reason-icon" set:html={ICONS[r.icon]} />
                <div>
                  <h3>{r.title}</h3>
                  <p>{r.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Sprockets />

  <section id="web-projects-grid">
    <div class="wrap">
      <div class="section-head" data-reveal data-reveal-group="wp-head">
        <div class="frame-tag"><span class="num">FRAME 017</span> Case Studies</div>
        {hasProjects ? (
          <h2 class="section-h" data-split-reveal>A few recent builds.</h2>
        ) : (
          <h2 class="section-h" data-split-reveal>The first case studies are <i>in progress.</i></h2>
        )}
        <p class="section-sub">
          {hasProjects
            ? 'Live sites and recent builds, shown here with permission.'
            : "This page is launching ahead of its first finished galleries - a few builds are underway now, with real case studies landing here as they're delivered."}
        </p>
      </div>

      {hasProjects ? (
        <div class="wp-grid">
          {projects.map((p) => (
            <div class="wp-card glass">
              {p.screenshot && (
                <Image src={p.screenshot} alt={p.title} class="wp-shot" widths={[400, 600, 800]} sizes="(max-width: 700px) 100vw, 33vw" loading="lazy" />
              )}
              <div class="wp-body">
                <h3>{p.title}</h3>
                <p>{p.description}</p>
                {p.href && <a href={p.href} target="_blank" rel="noopener noreferrer">Visit site →</a>}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <>
          <div class="wp-skeleton-grid" aria-hidden="true">
            {['camera', 'code', 'check'].map((i) => (
              <div class="wp-skeleton">
                <span class="wp-skeleton-icon" set:html={ICONS[i]} />
                <span class="mono">Coming Soon</span>
              </div>
            ))}
          </div>
          <div class="wp-empty glass" data-reveal data-reveal-group="wp-head">
            <p>
              <strong>Founder builds booking now</strong> alongside photography and video shoots — a
              website designed around real on-site imagery from day one, not stock photos dropped
              into a template afterward.
            </p>
            <a href="/contact" class="btn btn-ghost">Start a Project</a>
          </div>
        </>
      )}
    </div>
  </section>

  <Footer />
</Layout>

<!-- Animation bootstrap lives in Layout.astro's single shared script, not
     here - see that file's script comment for why a per-page script can't
     reliably do this once Astro's client-side page transitions are in
     play. -->

<style>
  /* Icon tiles shared visual language across this page's new sections -
     same recipe as local-seo.astro's .gbp-icon (brass, thin-line SVG). */
  .wp-step-icon, .wp-reason-icon, .wp-mock-hero-icon, .wp-skeleton-icon{
    color: var(--brass); display: block;
  }
  .wp-step-icon :global(svg), .wp-reason-icon :global(svg),
  .wp-mock-hero-icon :global(svg), .wp-skeleton-icon :global(svg){
    width: 100%; height: 100%;
  }

  .wp-steps{
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px;
    background: var(--line); border: 1px solid var(--line);
    margin-top: 44px;
  }
  @media (max-width: 900px){ .wp-steps{ grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px){ .wp-steps{ grid-template-columns: 1fr; } }
  .wp-step{
    background: var(--bg); padding: 32px 26px;
    transition: transform .3s ease;
  }
  .wp-step:hover{ transform: translateY(-4px); }
  .wp-step-icon{ width: 26px; height: 26px; margin-bottom: 18px; }
  .wp-step h3{ font-family: var(--font-display), serif; font-weight: 400; font-size: 21px; margin: 0 0 10px; }
  .wp-step p{ color: var(--paper-dim); font-size: 14px; line-height: 1.6; margin: 0; }

  /* Why-you-need-one two-column layout, same grid recipe as the
     photography.astro/local-seo.astro merges. */
  .wp-why-grid{ display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: center; }
  @media (max-width: 860px){ .wp-why-grid{ grid-template-columns: 1fr; gap: 44px; } }

  .wp-mock-wrap{ perspective: 1000px; }
  .wp-mock{
    background: var(--panel-2);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
    will-change: transform;
  }
  .wp-mock-chrome{
    display: flex; align-items: center; gap: 6px;
    padding: 12px 14px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }
  .wp-mock-chrome .dot{ width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
  .wp-mock-url{
    margin-left: 12px;
    font-size: 11px; color: var(--paper-dim);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 4px 10px;
  }
  .wp-mock-body{ padding: 20px; }
  .wp-mock-nav{ display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .wp-mock-logo{ width: 22px; height: 22px; border-radius: 3px; background: var(--brass); opacity: 0.8; }
  .wp-mock-nav span:not(.wp-mock-logo){ height: 6px; width: 34px; border-radius: 3px; background: var(--line-strong); }
  .wp-mock-nav span:last-child{ margin-left: auto; }
  .wp-mock-hero{
    aspect-ratio: 16/9;
    border-radius: 6px;
    margin-bottom: 18px;
    display: flex; align-items: center; justify-content: center;
    position: relative;
    overflow: hidden;
    background:
      repeating-linear-gradient(135deg, rgba(230,196,104,0.09) 0 2px, transparent 2px 14px),
      linear-gradient(160deg, #1A2029, #0A0E13);
  }
  .wp-mock-hero-icon{ width: 34px; height: 34px; opacity: 0.7; }
  /* A soft light sweep across the hero placeholder - reads as "content
     resolving into place" rather than a static grey box. Already covered
     by global.css's prefers-reduced-motion rule (all animation-duration
     forced to 0.01ms), no separate guard needed here. */
  .wp-mock-hero::after{
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(230,196,104,0.12) 50%, transparent 70%);
    background-size: 220% 100%;
    animation: wp-sweep 4.5s ease-in-out infinite;
  }
  @keyframes wp-sweep{
    0%{ background-position: 130% 0; }
    50%{ background-position: -30% 0; }
    100%{ background-position: -30% 0; }
  }
  .wp-mock-lines{ display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .wp-mock-lines span{ display: block; height: 7px; border-radius: 3px; background: var(--line-strong); }
  .wp-mock-lines .l1{ width: 70%; height: 10px; }
  .wp-mock-lines .l2{ width: 92%; }
  .wp-mock-lines .l3{ width: 55%; margin-bottom: 4px; }
  .wp-mock-btn{ width: 84px !important; height: 22px !important; border-radius: 4px !important; background: var(--brass) !important; margin-top: 6px; }

  .wp-why-copy .section-h{ margin-top: 18px; margin-bottom: 34px; }
  .wp-reasons{ display: flex; flex-direction: column; gap: 24px; }
  .wp-reason{ display: flex; gap: 18px; }
  .wp-reason-icon{ width: 24px; height: 24px; flex-shrink: 0; margin-top: 3px; }
  .wp-reason h3{ font-size: 16px; font-weight: 600; color: var(--paper); margin: 0 0 4px; }
  .wp-reason p{ font-size: 14px; line-height: 1.6; color: var(--paper-dim); margin: 0; }

  /* Empty-state skeleton row - honest "nothing here yet" placeholders
     (dashed border, no fabricated content) rather than a bare text block,
     so the section still has some visual presence while real case studies
     are pending. */
  .wp-skeleton-grid{
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    margin-top: 44px;
  }
  @media (max-width: 640px){ .wp-skeleton-grid{ grid-template-columns: 1fr; } }
  .wp-skeleton{
    aspect-ratio: 16/10;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-glass);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    color: var(--paper-dim); opacity: 0.6;
  }
  .wp-skeleton-icon{ width: 24px; height: 24px; }
  .wp-skeleton span.mono{ font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }

  .wp-grid{
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
    margin-top: 44px;
  }
  @media (max-width: 900px){ .wp-grid{ grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px){ .wp-grid{ grid-template-columns: 1fr; } }
  .wp-card{ border-radius: var(--radius-glass); overflow: hidden; }
  .wp-shot{ width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; }
  .wp-body{ padding: 20px; }
  .wp-body h3{ font-family: var(--font-display), serif; font-weight: 400; font-size: 19px; margin: 0 0 8px; }
  .wp-body p{ font-size: 14px; line-height: 1.55; color: var(--paper-dim); margin: 0 0 12px; }
  .wp-body a{ font-size: 13px; color: var(--brass); text-decoration: none; }
  .wp-body a:hover{ color: var(--brass-light); }

  .wp-empty{
    margin-top: 28px; max-width: 620px;
    padding: 32px;
    border-radius: var(--radius-glass);
    display: flex; flex-direction: column; gap: 20px; align-items: flex-start;
  }
  .wp-empty p{ margin: 0; font-size: 16px; line-height: 1.65; color: var(--paper-dim); }
  .wp-empty strong{ color: var(--paper); }
</style>
