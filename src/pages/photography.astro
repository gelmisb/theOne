---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sprockets from '../components/Sprockets.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/portfolio/Barbershops.jpg',
  { eager: true }
);
const heroImage = Object.values(heroImages)[0]?.default;

const included = [
  { k: 'Half-day on-site shoot', v: 'Shot at your business, not a studio — real premises, real staff, real product.' },
  { k: '15–20 edited photos', v: 'Colour-graded and delivered ready for your website, social channels, and Google Business Profile.' },
  { k: '5-day turnaround', v: 'From shoot day to delivered gallery — fast enough to fit around a launch or a seasonal push.' },
  { k: 'No web work required', v: "Works as a standalone refresh for existing listings, or as the foundation for a full website build." },
];
---

<Layout
  title="Business Photography in Wicklow — Horizon Vantage"
  description="On-site business photography for cafés, salons, gyms, clinics and tradespeople in Wicklow — shot by a working photographer, edited and delivered in 5 days."
>
  <Header transition:persist />

  <!-- Frames 008 (hero) + 009 (What's Included) merged into one two-column
       intro, founder request - the pitch and the concrete deliverables
       read as one connected statement instead of two stacked full-width
       sections. Reuses About.astro's image-card grid pattern (same
       aspect-ratio visual + caption recipe) rather than inventing a new
       one, so this reads as the same design system, not a one-off. -->
  <section class="photo-intro">
    <div class="wrap">
      <div class="ph-merge">
        <div class="ph-visual" data-reveal data-reveal-group="ph-merge">
          {heroImage && (
            <Image
              src={heroImage}
              alt="On-site business photography by Horizon Vantage"
              class="ph-visual-img"
              widths={[400, 600, 900]}
              sizes="(max-width: 860px) 100vw, 40vw"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <span class="cap mono">PHOTOGRAPHY — FRAME 008</span>
        </div>
        <div class="ph-copy">
          <div class="frame-tag" data-reveal data-reveal-group="ph-merge"><span class="num">FRAME 008</span> Photography</div>
          <h1 class="ph-h" data-reveal data-reveal-group="ph-merge">Real photos of your actual business, not another stock library.</h1>
          <p class="ph-lead" data-reveal data-reveal-group="ph-merge">
            Half a day on-site is enough to replace every generic stock photo on your website, your
            Google listing, and your social feeds with something that's actually yours.
          </p>

          <div class="ph-included" data-reveal data-reveal-group="ph-merge">
            <h2 class="ph-included-h" data-split-reveal>One visit covers everything a local listing actually needs.</h2>
            <p class="ph-included-sub">
              This is the Visual Refresh tier — the fastest, lowest-commitment way to fix the single
              biggest thing hurting most local business pages: photos that could belong to any
              business, anywhere.
            </p>
            <div class="ph-included-list">
              {included.map((s) => (
                <div class="ph-included-row">
                  <span class="k">{s.k}</span>
                  <span class="v">{s.v}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Sprockets />

  <section id="photography-why">
    <div class="wrap">
      <div class="section-head" data-reveal data-reveal-group="photo-why">
        <div class="frame-tag"><span class="num">FRAME 009</span> Why It Matters</div>
        <h2 class="section-h" data-split-reveal>Stock photos are why your website looks like <i>everyone else's.</i></h2>
      </div>
      <p class="why-body" data-reveal data-reveal-group="photo-why">
        Every competitor using the same stock library looks identical to a customer scrolling
        search results — same lighting, same staged smiles, same generic interiors. A real photo of
        your actual counter, your actual staff, your actual space is the fastest way to look like a
        real, trustworthy, currently-open business rather than a placeholder page. It's also what
        Google Business Profile rewards: listings with real, recent photos consistently outperform
        ones leaning on a logo and a stock banner.
      </p>
      <a href="/contact" class="btn btn-primary" data-reveal data-reveal-group="photo-why">Book a Founder Shoot</a>
    </div>
  </section>

  <Footer />
</Layout>

<!-- Animation bootstrap lives in Layout.astro's single shared script, not
     here - see that file's script comment for why a per-page script can't
     reliably do this once Astro's client-side page transitions are in
     play. -->

<style>
  .photo-intro{ padding-top: 170px; }
  @media (max-width: 640px){ .photo-intro{ padding-top: 130px; } }

  .ph-merge{ display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start; }
  @media (max-width: 860px){ .ph-merge{ grid-template-columns: 1fr; gap: 40px; } }

  /* Same recipe as About.astro's .about-visual - one shared "photo card"
     language across the site rather than a second bespoke treatment. */
  .ph-visual{
    aspect-ratio: 4/5;
    background:
      repeating-linear-gradient(135deg, rgba(79,168,222,0.12) 0 2px, transparent 2px 14px),
      linear-gradient(160deg, #1A2029, #0A0E13);
    border: 1px solid var(--line);
    position: relative;
    display: flex; align-items: flex-end; padding: 26px;
    overflow: hidden;
  }
  .ph-visual-img{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .6s ease;
  }
  .ph-visual:hover .ph-visual-img{ transform: scale(1.04); }
  .ph-visual::after{
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(10,14,19,0.75), transparent 45%);
    pointer-events: none;
  }
  .ph-visual .cap{
    position: relative; z-index: 1;
    font-family: var(--font-mono), monospace; font-size: 12px; color: var(--paper-dim);
  }

  .ph-h{
    font-family: var(--font-display), serif; font-weight: 400;
    font-size: clamp(32px, 4.4vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }
  .ph-lead{
    font-size: 18px; line-height: 1.6;
    color: var(--paper-dim);
    max-width: 560px;
    margin: 0 0 44px;
  }

  .ph-included-h{
    font-family: var(--font-display), serif; font-weight: 400;
    font-size: clamp(22px, 2.8vw, 30px);
    line-height: 1.15;
    margin: 0 0 14px;
  }
  .ph-included-sub{ font-size: 15px; line-height: 1.6; color: var(--paper-dim); margin: 0; }

  .ph-included-list{ margin-top: 26px; }
  .ph-included-row{ padding: 16px 0; border-top: 1px solid var(--line); }
  .ph-included-row:first-child{ border-top: none; }
  .ph-included-row .k{
    font-family: var(--font-display), serif; font-style: italic;
    font-size: 18px; color: var(--brass); display: block; margin-bottom: 4px;
  }
  .ph-included-row .v{ font-size: 14px; color: var(--paper-dim); line-height: 1.5; }

  .why-body{
    max-width: 720px; font-size: 17px; line-height: 1.75; color: var(--paper-dim);
    margin: 0 0 30px;
  }
</style>
