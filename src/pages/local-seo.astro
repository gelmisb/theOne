---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sprockets from '../components/Sprockets.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/portfolio/counter-service.jpg',
  { eager: true }
);
const heroImage = Object.values(heroImages)[0]?.default;

// Minimal hand-drawn line icons (24x24, stroke-based, currentColor) rather
// than pulling in an icon library for five glyphs - keeps this dependency-
// free and matches the site's existing thin-line/mono aesthetic. Rendered
// via set:html since this is static, author-written markup, not user input.
const ICONS: Record<string, string> = {
  tag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 8.5 3H19a2 2 0 0 1 2 2v10.5L14.5 21 3 9.5Z"/><circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></svg>',
  camera: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.6-2.4h6.8L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13.5" r="3.4"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m8.2 12.3 2.5 2.5 5-5.2"/></svg>',
  star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L12 3.5Z"/></svg>',
};

const rows = [
  { lbl: 'Category', val: 'Set & verified', icon: 'tag' },
  { lbl: 'Service area', val: 'Correctly defined', icon: 'pin' },
  { lbl: 'Photos', val: 'Shot on-site, not stock', icon: 'camera' },
  { lbl: 'NAP consistency', val: 'Matched across listings', icon: 'check' },
  { lbl: 'Reviews', val: 'NFC tap-to-review card', icon: 'star' },
];

const steps = [
  { n: '01', t: 'Claim & verify', d: "Confirm the listing is claimed, verified, and set to the correct business category — the single most common thing local listings get wrong." },
  { n: '02', t: 'Fix NAP consistency', d: "Name, address, and phone number matched exactly across your website, Google listing, and any other directories you're on. Mismatches quietly hurt ranking." },
  { n: '03', t: 'Load it with real photos', d: "Listings with real, recent, on-site photos consistently out-perform ones leaning on a logo and a stock banner — this is where the photography work does double duty." },
  { n: '04', t: 'Build a review habit', d: "An NFC tap-to-review card makes asking a happy customer for a review a five-second, no-typing action instead of an awkward request." },
];
---

<Layout
  title="Local SEO & Google Business Profile Setup — Wicklow — Horizon Vantage"
  description="Google Business Profile setup and local SEO for small businesses in Wicklow — category, service area, photos, and review systems done properly, not left to default settings."
>
  <Header transition:persist />

  <!-- Frames 014 (hero) + 015 (What Gets Fixed) merged into one two-column
       intro, same treatment as photography.astro's Frame 008/009 merge -
       see that file's comment for the reasoning and the shared
       About.astro-derived visual pattern. -->
  <section class="seo-intro">
    <div class="wrap">
      <div class="ph-merge">
        <div class="ph-visual" data-reveal data-reveal-group="seo-merge">
          {heroImage && (
            <Image
              src={heroImage}
              alt="Real, on-site business photos for Google Business Profile"
              class="ph-visual-img"
              widths={[400, 600, 900]}
              sizes="(max-width: 860px) 100vw, 40vw"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <span class="cap mono">LOCAL SEO — FRAME 012</span>
        </div>
        <div class="ph-copy">
          <div class="frame-tag" data-reveal data-reveal-group="seo-merge"><span class="num">FRAME 012</span> Local SEO</div>
          <h1 class="ph-h" data-reveal data-reveal-group="seo-merge">Your Google listing is doing more selling than your homepage.</h1>
          <p class="ph-lead" data-reveal data-reveal-group="seo-merge">
            Most local searches never make it past the map pack. A finished, verified, correctly
            categorised Google Business Profile is worth more than another homepage redesign.
          </p>

          <div class="ph-included" data-reveal data-reveal-group="seo-merge">
            <h2 class="ph-included-h" data-split-reveal>Worked into every Tier 2 and 3 package, not treated as an afterthought.</h2>
            <div class="gbp-grid">
              {rows.map((r) => (
                <div class="gbp-tile">
                  <span class="gbp-icon" set:html={ICONS[r.icon]} />
                  <span class="lbl">{r.lbl}</span>
                  <span class="val mono">{r.val}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Sprockets />

  <section id="local-seo-process">
    <div class="wrap">
      <div class="section-head" data-reveal data-reveal-group="seo-steps-head">
        <div class="frame-tag"><span class="num">FRAME 013</span> The Process</div>
        <h2 class="section-h" data-split-reveal>Four things, done properly instead of left on default settings.</h2>
      </div>
      <div class="seo-steps">
        {steps.map((s) => (
          <div class="seo-step" data-reveal data-reveal-group="seo-steps">
            <span class="seo-step-n mono">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
      <a href="/#contact" class="btn btn-primary" data-reveal data-reveal-group="seo-steps-head">Get Your Listing Fixed</a>
    </div>
  </section>

  <Footer />
</Layout>

<!-- Animation bootstrap lives in Layout.astro's single shared script, not
     here - see that file's script comment for why a per-page script can't
     reliably do this once Astro's client-side page transitions are in
     play. -->

<style>
  .seo-intro{ padding-top: 170px; }
  @media (max-width: 640px){ .seo-intro{ padding-top: 130px; } }

  .ph-merge{ display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start; }
  @media (max-width: 860px){ .ph-merge{ grid-template-columns: 1fr; gap: 40px; } }

  /* Same recipe as About.astro's .about-visual/photography.astro's
     .ph-visual - one shared "photo card" language, not a third bespoke one. */
  .ph-visual{
    aspect-ratio: 4/5;
    background:
      repeating-linear-gradient(135deg, rgba(79,168,222,0.12) 0 2px, transparent 2px 14px),
      linear-gradient(160deg, #1A2029, #0A0E13);
    border: 1px solid var(--line);
    position: relative;
    display: flex; align-items: flex-end; padding: 26px;
    overflow: hidden;
  }
  .ph-visual-img{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .6s ease;
  }
  .ph-visual:hover .ph-visual-img{ transform: scale(1.04); }
  .ph-visual::after{
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(10,14,19,0.75), transparent 45%);
    pointer-events: none;
  }
  .ph-visual .cap{
    position: relative; z-index: 1;
    font-family: var(--font-mono), monospace; font-size: 12px; color: var(--paper-dim);
  }

  .ph-h{
    font-family: var(--font-display), serif; font-weight: 400;
    font-size: clamp(32px, 4.4vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }
  .ph-lead{
    font-size: 18px; line-height: 1.6;
    color: var(--paper-dim);
    max-width: 560px;
    margin: 0 0 44px;
  }

  .ph-included-h{
    font-family: var(--font-display), serif; font-weight: 400;
    font-size: clamp(22px, 2.8vw, 30px);
    line-height: 1.15;
    margin: 0 0 22px;
  }

  /* Replaces the old flat .gbp-card list of label/value rows - icon tiles
     read faster at a glance and give the checklist some visual weight to
     match sitting opposite a full photo, rather than a plain text block. */
  .gbp-grid{
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;
  }
  @media (max-width: 480px){ .gbp-grid{ grid-template-columns: 1fr; } }
  .gbp-tile{
    padding: 20px; border: 1px solid var(--line); background: var(--panel);
    display: flex; flex-direction: column; gap: 10px;
  }
  .gbp-tile:last-child:nth-child(odd){ grid-column: 1 / -1; }
  .gbp-icon{ color: var(--brass); width: 26px; height: 26px; display: block; }
  .gbp-icon :global(svg){ width: 100%; height: 100%; }
  .gbp-tile .lbl{ font-size: 14px; color: var(--paper); font-weight: 600; }
  .gbp-tile .val{ font-size: 12px; color: var(--paper-dim); letter-spacing: 0.02em; }

  .seo-steps{
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;
    margin: 44px 0 40px;
  }
  @media (max-width: 700px){ .seo-steps{ grid-template-columns: 1fr; } }
  .seo-step{
    padding: 26px; border: 1px solid var(--line); background: var(--panel);
  }
  .seo-step-n{
    display: block; font-size: 12px; color: var(--brass); letter-spacing: 0.08em; margin-bottom: 10px;
  }
  .seo-step h3{ font-family: var(--font-display), serif; font-weight: 400; font-size: 20px; margin: 0 0 10px; }
  .seo-step p{ font-size: 14px; line-height: 1.6; color: var(--paper-dim); margin: 0; }
</style>
