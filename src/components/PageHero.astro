---
// Lightweight static header for the standalone service/info pages
// (Photography, Videography, Local SEO, Web Projects, About) - not the
// homepage's pinned cinematic Intro, just a frame-tag + h1 + subtitle in
// the same visual language, optionally with a background photo where one
// exists for that page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  frameNum: string;
  frameLabel: string;
  title: string;
  subtitle: string;
  image?: ImageMetadata;
}

const { frameNum, frameLabel, title, subtitle, image } = Astro.props;
---

<section class="page-hero">
  {image && (
    <div class="page-hero-bg" aria-hidden="true">
      <Image
        src={image}
        alt=""
        class="page-hero-img"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        loading="eager"
      />
      <div class="page-hero-scrim"></div>
    </div>
  )}
  <div class="wrap page-hero-inner">
    <div class="frame-tag"><span class="num">FRAME {frameNum}</span> {frameLabel}</div>
    <h1 class="page-hero-h">{title}</h1>
    <p class="page-hero-sub">{subtitle}</p>
  </div>
</section>

<style>
  .page-hero{
    position: relative;
    padding: 170px 0 90px;
    overflow: hidden;
  }
  .page-hero-bg{ position: absolute; inset: 0; z-index: 0; }
  .page-hero-bg :global(.page-hero-img){
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .page-hero-scrim{
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(230,196,104,0.14), transparent 60%),
      linear-gradient(180deg, rgba(10,14,19,0.72), rgba(10,14,19,0.88) 65%, var(--bg) 100%);
  }
  .page-hero-inner{ position: relative; z-index: 1; }
  .page-hero-h{
    font-family: 'Montserrat', serif; font-weight: 400;
    font-size: clamp(38px, 5.5vw, 66px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    max-width: 780px;
    margin: 0 0 20px;
  }
  .page-hero-sub{
    font-size: 18px; line-height: 1.6;
    color: var(--paper-dim);
    max-width: 560px;
    margin: 0;
  }
  @media (max-width: 640px){
    .page-hero{ padding: 130px 0 60px; }
  }
</style>
