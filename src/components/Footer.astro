---
import { Image } from 'astro:assets';
import logoMark from '../assets/photos/logo/logo_transparent.png';
import { business } from '../data/business';

const year = new Date().getFullYear();
// Same fix as Header.astro: these are homepage-section anchors, dead
// links from any of the new standalone pages without this prefix.
const homePrefix = Astro.url.pathname === '/' ? '' : '/';

// LinkedIn doesn't exist yet - shown only once it's real, rather than as a
// dead placeholder link to the platform's generic homepage. Add it back to
// SOCIALS the same way as the others below when it's up; SOCIAL_ICONS has it.
const SOCIALS = [
  { name: 'Instagram', href: business.instagram, icon: 'instagram' },
  { name: 'Facebook', href: business.facebook, icon: 'facebook' },
];
const SOCIAL_ICONS: Record<string, string> = {
  linkedin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8.5" r="0.9" fill="currentColor" stroke="none"/><path d="M8 11v6"/><path d="M12.5 17v-3.5a2 2 0 0 1 4 0V17"/><path d="M12.5 11v6"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M14 8.5h-1.5a2 2 0 0 0-2 2V12H14M10.5 12v6M10.5 12H9"/></svg>',
};
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="brand">
          <Image src={logoMark} alt="" class="brand-mark" width={64} height={64} />
          <span><em>Horizon</em> Vantage</span>
        </div>
        <p>Photography, videography, websites and local SEO - one local specialist, based in Co. Wicklow, shooting and building across Ireland.</p>
        <div class="foot-socials">
          {SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} set:html={SOCIAL_ICONS[s.icon]} />
          ))}
        </div>
      </div>
      <div class="foot-cols">
        <div class="foot-col">
          <h2>Studio</h2>
          <a href={`${homePrefix}#offer`}>The Offer</a>
          <a href={`${homePrefix}#portfolio`}>Portfolio</a>
          <a href={`${homePrefix}#process`}>Process</a>
          <a href={`${homePrefix}#about`}>About</a>
        </div>
        <div class="foot-col">
          <h2>Services</h2>
          <a href="/photography/">Photography</a>
          <a href="/videography/">Videography</a>
          <a href="/web-projects/">Website Design</a>
          <a href="/local-seo/">Local SEO</a>
        </div>
        <div class="foot-col">
          <h2>Who We Help</h2>
          <a href="/stays-and-experiences/">Stays &amp; Experiences</a>
          <a href="/food-and-drink/">Cafés, Bakeries &amp; Food Producers</a>
          <a href="/photography/">Shops, Salons &amp; Barbershops</a>
        </div>
        <div class="foot-col">
          <h2>Contact</h2>
          <a href="mailto:info@horizonvantage.ie">info@horizonvantage.ie</a>
          <a href="tel:+353894939050">+353 89 493 9050</a>
          <a href="/contact/">Enquiry form</a>
          <a href={business.googleProfile} target="_blank" rel="noopener noreferrer">Find us on Google <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          <a href={business.instagram} target="_blank" rel="noopener noreferrer">Instagram @horizonvantage</a>
          <a href={business.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} Horizon Vantage </span>
      <span>Co. Wicklow, Ireland</span>
      <a href="/terms/">Terms of Service</a>
      <a href="/privacy/">Privacy</a>
      <button type="button" class="foot-consent" data-open-consent>Cookie settings</button>
    </div>
  </div>
</footer>

<style>
  footer{ padding: 60px 0 40px; }
  .foot-grid{
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 30px;
    padding-bottom: 36px; border-bottom: 1px solid var(--line);
    margin-bottom: 26px;
  }
  .foot-brand .brand{ display: flex; align-items: center; gap: 10px; font-family: var(--font-display), serif; font-size: 22px; margin-bottom: 12px; }
  .foot-brand .brand em{ color: var(--brass); font-style: italic; }
  .foot-brand .brand :global(.brand-mark){ width: 28px; height: 28px; object-fit: contain; flex-shrink: 0; }
  .foot-brand p{ color: var(--paper-dim); font-size: 14px; max-width: 280px; line-height: 1.6; }
  .foot-socials{ display: flex; gap: 14px; margin-top: 18px; }
  .foot-socials a{
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px;
    color: var(--paper-dim);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: color .2s ease, border-color .2s ease;
  }
  .foot-socials a:hover{ color: var(--brass); border-color: var(--brass); }
  .foot-socials a :global(svg){ width: 16px; height: 16px; }
  .foot-cols{ display: flex; gap: 60px; flex-wrap: wrap; }
  .foot-col h2{
    font-family: var(--font-mono), monospace; font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--brass); margin: 0 0 16px;
  }
  .foot-col a{
    display: block; text-decoration: none; color: var(--paper-dim);
    font-size: 14px; margin-bottom: 10px; transition: color .2s;
  }
  .foot-col a:hover{ color: var(--paper); }
  .sr-only{
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .foot-bottom{
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    font-family: var(--font-mono), monospace; font-size: 11px; color: var(--paper-dim); opacity: 0.78;
  }
  .foot-bottom a{ text-decoration: none; transition: color 0.2s ease; }
  .foot-bottom a:hover{ color: var(--paper); }
  /* "Cookie settings" is a button (it opens the consent banner, no navigation)
     dressed to match the links beside it. */
  .foot-consent{
    background: none; border: none; padding: 0; margin: 0;
    font: inherit; color: inherit; cursor: pointer; text-decoration: none;
    transition: color 0.2s ease;
  }
  .foot-consent:hover{ color: var(--paper); }
</style>
