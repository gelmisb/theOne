---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="brand">Ready Frame <em>Studio</em></div>
        <p>Photography, videography, websites and local SEO for Irish small businesses — shot, built and optimised by one person.</p>
      </div>
      <div class="foot-cols">
        <div class="foot-col">
          <h4>Studio</h4>
          <a href="#offer">The Offer</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#process">Process</a>
          <a href="#about">About</a>
        </div>
        <div class="foot-col">
          <h4>Contact</h4>
          <a href="mailto:hello@readyframestudio.ie">hello@readyframestudio.ie</a>
          <a href="tel:+353000000000">+353 00 000 0000</a>
          <a href="#contact">Enquiry form</a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} Ready Frame Studio — working name, pending registration</span>
      <span>Dublin &amp; Commuter Belt, Ireland</span>
    </div>
  </div>
</footer>

<style>
  footer{ padding: 60px 0 40px; }
  .foot-grid{
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 30px;
    padding-bottom: 36px; border-bottom: 1px solid var(--line);
    margin-bottom: 26px;
  }
  .foot-brand .brand{ font-family: 'Instrument Serif', serif; font-size: 22px; margin-bottom: 12px; }
  .foot-brand .brand em{ color: var(--brass); font-style: italic; }
  .foot-brand p{ color: var(--paper-dim); font-size: 14px; max-width: 280px; line-height: 1.6; }
  .foot-cols{ display: flex; gap: 60px; flex-wrap: wrap; }
  .foot-col h4{
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--brass); margin: 0 0 16px;
  }
  .foot-col a{
    display: block; text-decoration: none; color: var(--paper-dim);
    font-size: 14px; margin-bottom: 10px; transition: color .2s;
  }
  .foot-col a:hover{ color: var(--paper); }
  .foot-bottom{
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--paper-dim); opacity: 0.6;
  }
</style>
