---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// No background image of its own anymore — the portal below reveals
// Layout.astro's persistent site background (.persist-bg) directly, since
// Intro's own section background is transparent. See initPersistBgFade in
// animations.ts for where that shared backdrop eventually fades out.

// Foreground "porthole" layer — a dark window opening onto the persistent
// background. The pinned scroll timeline zooms this dramatically toward
// the viewer, so it reads as flying through the window into the photo
// beyond.
const windowImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/intro-window.{jpg,jpeg,png,webp}',
  { eager: true }
);
const windowImage = Object.values(windowImages)[0]?.default;

// Video porthole — desktop only. All-intra encoding (required so
// ScrollTrigger can scrub currentTime without stutter) makes this file
// dramatically more expensive to decode than normal video, which is
// exactly the kind of thing that overwhelms weaker phone GPUs — on mobile
// it read as janky, not just slow to load. The <source media> query below
// means phones never fetch a single byte of it: the browser evaluates
// that query before requesting anything, same mechanism <picture> uses for
// responsive images. Below that breakpoint, and any time this folder is
// empty, Intro falls back to the static-image zoom transform — a plain
// CSS transform, cheap enough for any device.
//
// This folder holds nothing but that one clip, so any .mp4 dropped in here
// is picked up regardless of its exact filename — a mismatched name (e.g.
// intro_bg.mp4 vs. intro-bg.mp4) has silently fallen back to the static
// image before; matching the whole folder means that can't happen again.
//
// Re-encode raw footage with tools/encode-intro-video.sh before dropping it
// in here — an un-encoded drop will still play on desktop, just with
// visible stutter once scroll-scrubbing kicks in. mp4/H.264 only,
// deliberately: all-intra encoding defeats VP9's inter-frame compression,
// so a webm here would be dead weight — larger than the mp4 with no reach
// benefit, since H.264 already covers effectively every browser this site
// targets.
const introVideos = import.meta.glob<string>('/src/assets/videos/*.mp4', {
  eager: true,
  import: 'default',
});
const bgMp4 = Object.values(introVideos)[0];
const hasVideo = Boolean(bgMp4);
---

<section class="intro" id="intro">
  <div class="intro-scrim" aria-hidden="true"></div>

  <div class:list={['intro-image-container', { 'has-video': hasVideo }]} aria-hidden="true">
    {hasVideo && (
      <video
        class="intro-feature intro-feature-video"
        data-intro-video
        muted
        playsinline
        preload="auto"
        poster={windowImage?.src}
      >
        <source src={bgMp4} type="video/mp4" media="(min-width: 641px)" />
      </video>
    )}
    {windowImage && (
      <Image
        src={windowImage}
        alt=""
        class="intro-feature intro-feature-image"
        data-intro-feature
        widths={[640, 960, 1280, 1456]}
        sizes="100vw"
        loading="eager"
      />
    )}
  </div>

  <div class="intro-frame" aria-hidden="true">
    <span class="ic-corner tl"></span>
    <span class="ic-corner tr"></span>
    <span class="ic-corner bl"></span>
    <span class="ic-corner br"></span>
  </div>

  <div class="intro-reveal">
    <div class="wrap intro-inner">
      <div class="frame-tag" data-intro-el><span class="num1">FRAME 000</span></div>
      <div class="intro-word"><em>Horizon</em> Vantage</div>
      <p class="intro-slogan mono" data-intro-el>See Further. Show It Better.</p>
      <p class="intro-tag mono" data-intro-el>Photography · Video · Websites · Local SEO — Ireland</p>
    </div>
  </div>

  <div class="intro-scroll mono" aria-hidden="true">
    <span>Scroll</span>
    <span class="intro-scroll-line"></span>
  </div>
</section>

<style>
  .intro{
    position: relative;
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    text-align: center;
    perspective: 500px;
  }

  .intro-scrim{
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 900px 600px at 50% 45%, rgba(212,175,55,0.14), transparent 60%),
      linear-gradient(180deg, rgba(10,14,19,0.5), rgba(10,14,19,0.65) 100%);
  }

  .intro-image-container{
    position: absolute; inset: 0;
    z-index: 1;
    perspective: 500px;
    overflow: hidden;
  }
  .intro-image-container :global(.intro-feature){
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  /* Below 641px: image only, video layer hidden (and, thanks to the
     <source media> query in the markup, never fetched at all). At and
     above it: video takes over, image hides. Scoped to .has-video so a
     site with no video asset yet just always shows the image, at every
     width, matching the old fallback-only behavior. */
  .intro-image-container.has-video :global(.intro-feature-video){ display: none; }
  @media (min-width: 641px){
    .intro-image-container.has-video :global(.intro-feature-video){ display: block; }
    .intro-image-container.has-video :global(.intro-feature-image){ display: none; }
  }
  .intro-frame{ position: absolute; inset: 28px; pointer-events: none; z-index: 2; }
  .ic-corner{
    position: absolute; width: 34px; height: 34px;
    border-color: var(--paper-dim);
    opacity: 0.3;
  }
  .ic-corner.tl{ top: 0; left: 0; border-top: 2px solid; border-left: 2px solid; }
  .ic-corner.tr{ top: 0; right: 0; border-top: 2px solid; border-right: 2px solid; }
  .ic-corner.bl{ bottom: 0; left: 0; border-bottom: 2px solid; border-left: 2px solid; }
  .ic-corner.br{ bottom: 0; right: 0; border-bottom: 2px solid; border-right: 2px solid; }

  .intro-reveal{
    position: relative; z-index: 3;
    clip-path: circle(150% at 50% 50%);
    margin-bottom: 200px;
  }
  .intro-inner{ display: flex; flex-direction: column; align-items: center; }
  .intro-inner .frame-tag{ justify-content: center; }
  .intro-word{
    font-family: 'Montserrat', serif; font-weight: 400;
    font-size: clamp(44px, 9vw, 120px);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 8px 0 22px;
    text-shadow: 2px 3px 10px black;
  }
  .intro-word em{ color: var(--brass); font-style: italic; }
  .intro-slogan{
    font-size: 14px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--brass);
    margin: 0 0 16px;
  }
  .intro-tag{
    font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--paper-dim);
  }

  .intro-scroll{
    position: absolute; left: 50%; bottom: 36px; z-index: 3;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--paper-dim);
  }
  .intro-scroll-line{
    width: 1px; height: 34px;
    background: linear-gradient(180deg, var(--paper-dim), transparent);
    animation: intro-scroll-pulse 2.2s ease-in-out infinite;
  }
  @keyframes intro-scroll-pulse{
    0%, 100%{ opacity: 0.3; transform: scaleY(0.7); transform-origin: top; }
    50%{ opacity: 0.9; transform: scaleY(1); transform-origin: top; }
  }
  @media (prefers-reduced-motion: reduce){
    .intro-scroll-line{ animation: none; opacity: 0.6; }
  }

  @media (max-width: 640px){
    .intro-scroll{ bottom: 24px; }
  }

  /* Pre-hide the reveal in CSS, matching initIntroTimeline's starting
     tween values (animations.ts) — without this, the heading paints
     fully visible on first load, then GSAP snaps it hidden the instant
     the script runs, then animates it back in: a visible → hidden →
     visible flash that reads as a double blink. Gated to no-preference
     so the reduced-motion path (which never hides anything) still shows
     everything immediately, as intended. */
  @media (prefers-reduced-motion: no-preference){
    .intro-reveal{ clip-path: circle(0% at 50% 50%); }
    [data-intro-el], .intro-word, .intro-scroll{ opacity: 0; }
    [data-intro-el], .intro-word{ transform: translateY(16px); }
  }
</style>
