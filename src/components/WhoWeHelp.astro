---
import { frameNumber } from '../data/homeFrames';

// Audience cards, so a visitor can self-identify early instead of reading the
// whole page to find out if this applies to them. The work is for local
// businesses of every kind (founder confirmed 2026-10-23 - cafés, bakeries,
// pet shops, barbershops and so on, not just stays and producers), so these
// are sector groups, not a statement of who the site is exclusively for.
// Stays and food/drink have their own landing pages; shops and salons don't
// have one yet, so that card points at the on-site photography page.
const audiences = [
  {
    title: 'Cafés, bakeries and food producers',
    desc: 'Cafés, bakeries, farm shops, makers and artisan producers. Photos of what you serve and make, on a site that takes orders.',
    href: '/food-and-drink/',
  },
  {
    title: 'Shops, salons and barbershops',
    desc: 'Pet shops, barbershops, salons, gyms and independent retailers. Real photos of your premises, your team and your products.',
    href: '/photography/',
  },
  {
    title: 'Stays and experiences',
    desc: 'Holiday lets, glamping, B&Bs, guesthouses, activity providers and small venues. Show guests the real place before they arrive.',
    href: '/stays-and-experiences/',
  },
];
---

<section id="who-we-help">
  <div class="wrap">
    <div class="section-head" data-reveal data-reveal-group="who-head">
      <div class="frame-tag"><span class="num">FRAME {frameNumber('who-we-help')}</span> Who We Help</div>
      <h2 class="section-h" data-split-reveal>Every kind of local business, one way of working.</h2>
    </div>
    <div class="who-grid">
      {audiences.map((a) => (
        <a class="who-card glass" href={a.href} data-reveal data-reveal-group="who-cards">
          <h3>{a.title}</h3>
          <p>{a.desc}</p>
          <span class="who-link mono">See how →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .who-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 860px){ .who-grid{ grid-template-columns: 1fr; } }
  .who-card{
    display: flex; flex-direction: column;
    padding: 38px 32px;
    border-radius: var(--radius-glass);
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease;
  }
  .who-card:hover{ transform: translateY(-4px); border-color: rgba(79,168,222,0.5); }
  .who-card h3{
    font-family: var(--font-display), serif; font-weight: 400; font-size: 26px;
    color: var(--paper); margin: 0 0 14px;
  }
  .who-card p{ font-size: 15px; line-height: 1.65; color: var(--paper-dim); margin: 0 0 24px; }
  .who-link{ margin-top: auto; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--brass); }
</style>
