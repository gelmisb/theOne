---
---

<header>
  <div class="nav-shell">
    <div class="wrap nav">
      <div class="brand"><em>Horizon</em> Vantage</div>
      <nav class="navlinks">
        <a href="#offer">The Offer</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#process">Process</a>
        <a href="#about">About</a>
        <a href="#contact" class="nav-cta">Book a Shoot</a>
      </nav>
    </div>
  </div>
</header>

<style>
  header{
    position: sticky; top: 0; z-index: 50;
    padding: 0;
  }
  .nav-shell{
    margin: 0 auto;
    max-width: 1180px;
    border-radius: 0;
    border: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    transition: margin .35s ease, border-radius .35s ease, background .35s ease,
      border-color .35s ease, box-shadow .35s ease, backdrop-filter .35s ease;
  }
  header:global(.scrolled) .nav-shell{
    margin: 12px auto 0;
    border-radius: var(--radius-glass);
    background: rgba(26,32,41,0.55);
    backdrop-filter: blur(20px) saturate(1.7);
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    border: 1px solid rgba(234,242,248,0.16);
    box-shadow:
      0 8px 32px rgba(0,0,0,0.28),
      inset 0 1px 0 rgba(255,255,255,0.07);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))){
    header:global(.scrolled) .nav-shell{ background: rgba(10,14,19,0.94); }
  }
  .nav{
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 32px;
  }
  header:global(.scrolled) .nav{ padding: 14px 28px; }
  @media (max-width: 640px){
    .nav{ padding: 18px 20px; }
    header:global(.scrolled) .nav-shell{ margin: 8px 12px 0; }
  }
  .brand{
    font-family: 'Montserrat', serif;
    font-size: 22px;
    letter-spacing: 0.01em;
    color: var(--paper);
  }
  .brand em{ color: var(--brass); font-style: italic; }
  .navlinks{ display: flex; gap: 34px; align-items: center; }
  .navlinks a{
    text-decoration: none; color: var(--paper-dim);
    font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase;
    font-family: 'IBM Plex Mono', monospace;
    transition: color .2s ease;
  }
  .navlinks a:hover, .navlinks a:focus-visible{ color: var(--brass); }
  .navlinks a:focus-visible{ outline: 1px solid var(--brass); outline-offset: 4px; }
  .nav-cta{
    padding: 10px 18px;
    border: 1px solid var(--brass);
    color: var(--brass) !important;
    border-radius: var(--radius);
  }
  .nav-cta:hover{ background: var(--brass); color: var(--bg) !important; }
  @media (max-width: 860px){
    .navlinks a:not(.nav-cta){ display: none; }
    .nav-cta{ font-size: 11px; padding: 9px 14px; }
  }
</style>
