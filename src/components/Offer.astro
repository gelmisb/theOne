---
const tiers = [
  {
    num: 'TIER 01',
    name: 'Visual Refresh',
    price: '€350–600',
    purpose: 'Fast first sale, low commitment',
    desc: 'A half-day on-site shoot. 15–20 edited photos plus one short promo video clip, delivered on a 5-day turnaround. No website work required — just new, real imagery for your existing listings and social channels.',
    core: false,
  },
  {
    num: 'TIER 02',
    name: 'Complete Local Presence',
    price: '€1,500–2,500',
    purpose: 'Priced against pure web studios — with a real edge',
    desc: 'On-site photo and video shoot, a custom website build designed around those images, and full Google Business Profile setup and optimisation. This is the package that actually fixes a business\'s online presence, not just its homepage.',
    core: true,
  },
  {
    num: 'TIER 03',
    name: 'Growth Retainer',
    price: '€75–150',
    priceSuffix: '/mo',
    purpose: 'Recurring, on top of the project fee',
    desc: 'Hosting and maintenance, a quarterly content refresh — new seasonal photos and a short clip — plus ongoing review monitoring, so the site and listing stay current long after launch.',
    core: false,
  },
];
---

<section id="offer">
  <div class="wrap">
    <div class="section-head" data-reveal data-reveal-group="offer-head">
      <div class="frame-tag"><span class="num">FRAME 002</span> The Offer</div>
      <h2 class="section-h">Three tiers, built for how local businesses actually decide.</h2>
      <p class="section-sub">
        Start small with a single decision-maker and no web build required, or go straight for the
        full local presence package.
      </p>
    </div>

    <div class="tiers">
      {tiers.map((t) => (
        <div class:list={['tier', { core: t.core }]} data-reveal data-reveal-group="tier-cards">
          {t.core && <span class="badge">Core Offer</span>}
          <div class="tier-num mono">{t.num}</div>
          <h3>{t.name}</h3>
          <div class="price">{t.price}{t.priceSuffix && <span class="suffix">{t.priceSuffix}</span>}</div>
          <div class="purpose">{t.purpose}</div>
          <p class="desc">{t.desc}</p>
        </div>
      ))}
    </div>

    <div class="addon" data-reveal data-reveal-group="offer-head">
      <div class="t"><strong>NFC "Tap to Review" card</strong> — bundled into Tier 2/3, or sold on its own</div>
      <div class="price">€25–35 <span class="unit">/ card</span></div>
    </div>
  </div>
</section>

<style>
  .tiers{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 900px){ .tiers{ grid-template-columns: 1fr; } }
  .tier{
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 38px 32px;
    display: flex; flex-direction: column;
    position: relative;
    transition: border-color .2s ease, transform .2s ease;
  }
  .tier:hover{ border-color: var(--line-strong); transform: translateY(-4px); }
  .tier.core{ border-color: var(--brass); background: var(--panel-2); }
  .tier .badge{
    position: absolute; top: -1px; right: -1px;
    background: var(--brass); color: var(--bg);
    font-family: 'IBM Plex Mono', monospace; font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 6px 12px;
  }
  .tier .tier-num{ font-family: 'IBM Plex Mono', monospace; color: var(--brass); font-size: 12px; margin-bottom: 16px; letter-spacing: 0.08em; }
  .tier h3{ font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 28px; margin: 0 0 10px; }
  .tier .price{ font-family: 'IBM Plex Mono', monospace; font-size: 22px; color: var(--brass); margin-bottom: 6px; }
  .tier .price .suffix{ font-size: 14px; opacity: .7; }
  .tier .purpose{ font-size: 13px; color: var(--paper-dim); font-style: italic; margin-bottom: 26px; }
  .tier .desc{ font-size: 15px; line-height: 1.6; color: var(--paper-dim); margin: 0; flex-grow: 1; }

  .addon{
    margin-top: 28px;
    border: 1px dashed var(--line-strong);
    padding: 22px 24px;
    display: flex; justify-content: space-between; align-items: center;
    gap: 20px; flex-wrap: wrap;
  }
  .addon .t{ font-size: 14px; color: var(--paper-dim); }
  .addon .t strong{ color: var(--paper); font-weight: 600; }
  .addon .price{ font-family: 'IBM Plex Mono', monospace; color: var(--brass); font-size: 16px; white-space: nowrap; }
  .addon .unit{ opacity: .6; font-size: 12px; }
</style>
