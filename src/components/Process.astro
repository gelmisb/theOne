---
// 5 steps (was 3) - REFOCUS_BRIEF.md section 3, matching the free-audit-led
// funnel the rest of the site now points to (Hero's primary CTA, Offer's
// "final quote after your free audit" line on every tier).
const steps = [
  {
    exif: 'f/2.8 · ISO 200 · 1/250s',
    title: 'Free listing audit',
    desc: 'A short review of your photos, Google profile and booking page, with three quick wins.',
  },
  {
    exif: 'f/4 · ISO 100 · 1/60s',
    title: 'Plan',
    desc: 'Agree the shot list, timing and what the site needs to do.',
  },
  {
    exif: 'f/5.6 · ISO 400 · 1/125s',
    title: 'Shoot',
    desc: 'On site, at your property, at the right light.',
  },
  {
    exif: 'f/2.8 · ISO 100 · 1/200s',
    title: 'Build',
    desc: 'A fast website with booking or ordering set up, and your Google Business Profile tidied.',
  },
  {
    exif: 'f/4 · ISO 200 · 1/160s',
    title: 'Launch and care',
    desc: 'Go live, then keep it fresh through the seasons.',
  },
];
---

<section id="process">
  <div class="wrap">
    <div class="section-head" data-reveal data-reveal-group="process-head">
      <div class="frame-tag"><span class="num">FRAME 004</span> How It Works</div>
      <h2 class="section-h">Free audit first. Nothing else until you say go.</h2>
    </div>
    <div class="process">
      {steps.map((s) => (
        <div class="step" data-reveal data-reveal-group="process-steps">
          <div class="exif">{s.exif}</div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* 5 steps now (was 3) - 5-col desktop, 3-col tablet (wraps 3+2), 1-col mobile. */
  .process{
    display: grid; grid-template-columns: repeat(5,1fr); gap: 2px;
    background: var(--line); border: 1px solid var(--line);
  }
  @media (max-width: 1100px){ .process{ grid-template-columns: repeat(3,1fr); } }
  @media (max-width: 700px){ .process{ grid-template-columns: 1fr; } }
  .step{
    background: var(--bg); padding: 32px 24px;
    position: relative; z-index: 0;
    transition: transform .3s ease;
  }
  .step:hover{ transform: translateY(-4px); z-index: 1; }
  .step:hover{
    background: rgba(26,32,41,0.55);
    backdrop-filter: blur(20px) saturate(1.7);
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    box-shadow:
      0 8px 32px rgba(0,0,0,0.28),
      inset 0 1px 0 rgba(255,255,255,0.07);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))){
    .step:hover{ background: rgba(18,24,31,0.92); }
  }
  .step .exif{ margin-bottom: 20px; font-size: 11px; }
  .step h3{ font-family: var(--font-display), serif; font-weight: 400; font-size: 21px; margin: 0 0 12px; }
  .step p{ color: var(--paper-dim); font-size: 14px; line-height: 1.6; margin: 0; }
</style>
