---
// Honest, minimal consent notice - this site currently sets no cookies
// beyond what's strictly necessary to run (no analytics, no ad trackers),
// so there's nothing real to offer an Accept/Reject choice between. If
// analytics or ad pixels are added later, gate their init calls behind
// `localStorage.getItem('hv-cookie-consent') === 'accepted'` and swap this
// for a real two-choice banner at that point.
//
// hv-newsletter-subscribed (initNewsletterSignup, animations.ts) joins
// hv-cookie-consent (this banner's own flag) in the same "strictly
// necessary, functional only" category - it just remembers that this
// browser already signed up, so the form isn't shown again, and isn't used
// for tracking or profiling. Mentioned explicitly below rather than left
// implicit under "essential cookies", since it's real, user-visible storage
// and the whole point of this banner is not saying less than what's true.
---

<div class="cookie-banner glass" id="cookie-banner" hidden>
  <div class="cookie-banner-inner wrap">
    <p class="cookie-banner-text">
      This site runs on essential cookies only - to remember this choice, and whether you've
      signed up for updates. No trackers, no ads, no analytics.
    </p>
    <button type="button" class="btn btn-primary cookie-banner-accept" id="cookie-banner-accept">Got it</button>
  </div>
</div>

<script>
  const CONSENT_KEY = 'hv-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-banner-accept');

  if (banner && !localStorage.getItem(CONSENT_KEY)) {
    banner.removeAttribute('hidden');
    requestAnimationFrame(() => banner.classList.add('is-visible'));
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'accepted');
    banner?.classList.remove('is-visible');
    banner?.addEventListener('transitionend', () => banner.setAttribute('hidden', ''), { once: true });
  });
</script>

<style>
  .cookie-banner{
    position: fixed; left: 0; right: 0; bottom: 0;
    z-index: 1000;
    padding: 18px 0;
    padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    border-left: none; border-right: none; border-bottom: none;
    transform: translateY(100%);
    transition: transform 0.4s ease;
  }
  .cookie-banner.is-visible{ transform: translateY(0); }
  .cookie-banner-inner{
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    flex-wrap: wrap;
  }
  .cookie-banner-text{
    margin: 0; font-size: 13px; line-height: 1.5; color: var(--paper-dim); max-width: 640px;
  }
  .cookie-banner-accept{ flex-shrink: 0; padding: 12px 22px; }
  @media (max-width: 560px){
    .cookie-banner-inner{ flex-direction: column; align-items: stretch; text-align: center; }
  }
</style>
