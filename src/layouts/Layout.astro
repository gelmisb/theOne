---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import CookieBanner from '../components/CookieBanner.astro';
import logoDark from '../assets/photos/logo/logo_dark.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Horizon Vantage - Photography, Video, Websites & Local SEO for Irish Businesses',
  description = 'On-site photography and video, a custom website, and local SEO - bundled into one package for Irish small businesses. Shot, built and optimised by a working photographer and software engineer.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// The full dark-background logo lockup (mark + wordmark + tagline) as the
// social share preview - replaces the old portal-intro artwork now that a
// real branded asset exists. fit: 'contain' (not the default 'cover') -
// the source is a square 2000x2000 canvas with the mark stacked above the
// wordmark and tagline; a plain cover-crop into 1200x630 sliced off the
// tagline and most of the wordmark. background matches the source's own
// near-black canvas so the letterbox bars this adds on either side are
// invisible rather than a visible seam.
// format: 'jpg' explicitly - astro:assets defaults to webp, which most
// social platforms handle fine today but is still an unnecessary risk for
// a link-preview image specifically (the one place a crawler that mishandles
// webp costs an actual bad first impression, not just a slower page).
const ogImageAsset = await getImage({ src: logoDark, width: 1200, height: 630, fit: 'contain', background: '#000000', format: 'jpg' });
const ogImageURL = new URL(ogImageAsset.src, Astro.site);

// LocalBusiness structured data - this is what feeds Google's map-pack/
// knowledge-panel understanding of the business, not just the meta tags.
// Site-wide (every page gets the same entity), matching terms.astro's
// registered address and the founder's confirmed Wicklow + Dublin/Leinster
// service area.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${Astro.site}#business`,
  name: 'Horizon Vantage',
  url: Astro.site,
  image: ogImageURL.toString(),
  description:
    'On-site photography, videography, website development, and local SEO for small and medium-sized businesses in Ireland.',
  telephone: '+353894939050',
  email: 'info@horizonvantage.ie',
  priceRange: '€350-€2500',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Wicklow',
    addressCountry: 'IE',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'County Wicklow' },
    { '@type': 'AdministrativeArea', name: 'County Dublin' },
    { '@type': 'AdministrativeArea', name: 'Leinster' },
  ],
  founder: {
    '@type': 'Person',
    name: 'Gelmis Bartulis',
  },
};

// Persistent journey background: revealed through Intro's portal, stays
// fixed behind Hero, then fades out on scroll as Gap comes into view (see
// initPersistBgFade in animations.ts). Sits behind every section at
// z-index -1, so each of those sections' own backgrounds must stay
// transparent for it to actually show through.
const persistImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/persist-bg.{jpg,jpeg,png,webp}',
  { eager: true }
);
const persistImage = Object.values(persistImages)[0]?.default;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Horizon Vantage" />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

    <!-- SPA-style client-side navigation (astro:transitions) instead of a
         full page reload per link click - a hard reload was the actual
         source of the "jittery" feel switching between the new standalone
         pages: a white flash, GSAP/Lenis re-initializing from a cold DOM,
         and every fixed-position layer (header, persist-bg, grain,
         vignette) visibly re-painting from scratch. ClientRouter fetches
         the next page in the background and cross-fades the swap via the
         browser's View Transitions API instead. -->
    <ClientRouter />
  </head>
  <body>
    {persistImage && (
      <div class="persist-bg" data-persist-bg aria-hidden="true" transition:persist>
        <Image src={persistImage} alt="" class="persist-bg-img" widths={[640, 960, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
        <!-- dev3 experiment (see src/scripts/ambient-bg.ts for the full
             reasoning) - a mouse-reactive WebGL shader layered over the
             photo via mix-blend-mode:screen, not replacing it. Lives
             inside .persist-bg specifically so it inherits the exact same
             scroll-driven fade-out initPersistBgFade already drives
             (opacity to 0 as Gap scrolls into view) - ambient-bg.ts's own
             ScrollTrigger mirrors those same boundaries to pause
             rendering once it's invisible, rather than adding a second,
             independent fade. If initAmbientBackground bails out early
             (prefers-reduced-motion, no WebGL support) this canvas simply
             never gets a rendering context - a transparent, empty element
             sitting over the photo, same as not being there at all. -->
        <canvas class="ambient-bg" data-ambient-bg aria-hidden="true"></canvas>
        <div class="persist-bg-scrim"></div>
      </div>
    )}
    <slot />
    <div class="grain" aria-hidden="true" transition:persist></div>
    <div class="vignette" aria-hidden="true" transition:persist></div>
    <CookieBanner />
  </body>
</html>

<script>
  // Every page-animation bootstrap call lives here, in the ONE script that's
  // byte-identical across every page (Layout.astro is shared) - not split
  // per page as it used to be. Two things forced that:
  //
  // 1. astro:before-swap/astro:page-load have to be wired up exactly once
  //    for the whole session, not per page - Astro's client router
  //    deduplicates inline <script> tags by content across the *entire*
  //    session (not just against the immediately-previous page), so a
  //    script tag that already ran once (e.g. on the very first load of
  //    "/") is recognized as "already executed" and silently skipped on
  //    every later visit back to that same page, however many other pages
  //    you'd visited in between. A per-page script that assigned its own
  //    init logic on each visit (an earlier version of this) broke exactly
  //    on revisits for that reason - home worked once, then went dead on
  //    the second visit back. Only this file's script is guaranteed
  //    identical (and therefore reliably deduped to one registration) on
  //    every single page, so it's the only safe place to register
  //    session-lifetime listeners.
  // 2. Since only ONE inline script can be relied on to actually run,
  //    every init function used anywhere on the site is called from here,
  //    unconditionally, on every page. That's safe because every one of
  //    them already guards on its own target elements existing (a
  //    homepage-only effect like the film-roll intro or the hero timeline
  //    just no-ops on a page with no #hero) - the guard clauses, not which
  //    page's script happened to import what, are what decide which
  //    effects actually apply to the current page.
  import {
    teardownForTransition,
    initScrollHashFix,
    initFilmRollIntro,
    initMobileIntroVideo,
    initScrollReveals,
    initPersistBgFade,
    initHeroTimeline,
    initHeroParallax,
    initContactSheetReveal,
    initNavOnScroll,
    initMobileNav,
    initMagneticButtons,
    initWebMockTilt,
    initPortfolioLightbox,
    initNewsletterSignup,
    initVideoLightbox,
    initScrollNav,
    initHeadingSplitReveal,
    initSectionTransitions,
  } from '../scripts/animations';
  import { initSmoothScroll } from '../scripts/lenis';
  import { initAmbientBackground, initIntroAmbientGlow } from '../scripts/ambient-bg';

  document.addEventListener('astro:before-swap', teardownForTransition);
  document.addEventListener('astro:page-load', () => {
    initSmoothScroll();
    initScrollHashFix();
    initFilmRollIntro();
    initMobileIntroVideo();
    initAmbientBackground();
    initIntroAmbientGlow();
    initPersistBgFade();
    initHeroTimeline();
    initHeroParallax();
    initScrollReveals();
    initContactSheetReveal();
    initNavOnScroll();
    initMobileNav();
    initMagneticButtons();
    initWebMockTilt();
    initPortfolioLightbox();
    initNewsletterSignup();
    initVideoLightbox();
    initScrollNav();
    initHeadingSplitReveal();
    initSectionTransitions();
  });
</script>

<style>
  .persist-bg{
    position: fixed; inset: 0;
    z-index: -1;
  }
  .persist-bg-img{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(0.25) sepia(0.3) hue-rotate(155deg) saturate(1.3) brightness(0.4) contrast(1.05);
  }
  .persist-bg-scrim{
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(10,14,19,0.5), rgba(10,14,19,0.7) 60%, rgba(10,14,19,0.85) 100%);
  }
  /* dev3 experiment - see the markup comment above and ambient-bg.ts for
     the full reasoning. screen blending only ever brightens, so the
     shader's mostly-black base lets the photo underneath show through
     untouched and only its glow actually adds anything; opacity pulls it
     back further so it reads as atmosphere over the photo, not a second
     competing visual. pointer-events:none so it never intercepts clicks
     meant for real content sitting on top. */
  .ambient-bg{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    mix-blend-mode: screen;
    opacity: 0.75;
    pointer-events: none;
  }
</style>
