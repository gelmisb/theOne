# Security headers for every page. (A full Content-Security-Policy is deliberately
# not set: the site relies on inline scripts and JSON-LD, so a CSP needs hashes or
# nonces and its own testing pass.)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Astro fingerprints everything in /_astro/ (the name changes when the content does),
# so browsers can keep it for a year and repeat visitors re-download nothing.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the private dashboard out of search results even if a crawler ever finds it.
# (The page also carries a noindex meta tag; this covers the HTTP side.)
/analytics
  X-Robots-Tag: noindex, nofollow
/analytics/*
  X-Robots-Tag: noindex, nofollow
